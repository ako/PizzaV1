mdl 1;
-- SCR-07 payment sheet, SCR-08 confirmation, SCR-09 tracking, SCR-10 lookup,
-- SCR-13 receipt, SCR-40/41 error pages and the home build panel (EP-06/07/09/15).

/** Copies a text to the clipboard (copy commit hash / tracking link, US-110 AC2). */
create or modify javascript action Shop."JS_CopyText" (
  /** Text to copy. */
  Text: String not null
) returns Boolean
as $$
    try { await navigator.clipboard.writeText(text); return true; } catch (e) { return false; }
$$;

/** Opens the browser print dialog (Print receipt, US-167). */
create or modify javascript action Shop."JS_Print" () returns Boolean
as $$
    window.print();
    return true;
$$;

/**
 * Copy the commit hash and confirm with a toast (US-110 AC2).
 *
 * @param $View The track view
 */
create or modify nanoflow Shop.NF_CopyHash ($View: Shop.TrackView)
folder 'Tracking'
begin
  retrieve $O from $View/Shop.TrackView_Order;
  $Copied = call javascript action Shop.JS_CopyText(Text = $O/CommitHash);
  call microflow Shop.ACT_Toast_Copied();
end;
grant execute on nanoflow Shop.NF_CopyHash to Shop.Guest, Shop.Administrator; -- auto

/**
 * Copy the personal tracking link (US-110 AC5).
 *
 * @param $View The track view
 */
create or modify nanoflow Shop.NF_CopyLink ($View: Shop.TrackView)
folder 'Tracking'
begin
  $Copied = call javascript action Shop.JS_CopyText(Text = $View/TrackingUrl);
  call microflow Shop.ACT_Toast_Copied();
end;
grant execute on nanoflow Shop.NF_CopyLink to Shop.Guest, Shop.Administrator; -- auto

/** Print receipt (US-167). */
create or modify nanoflow Shop.NF_Print ()
folder 'Tracking'
begin
  $Printed = call javascript action Shop.JS_Print();
end;
grant execute on nanoflow Shop.NF_Print to Shop.Guest, Shop.Administrator; -- auto

/**
 * Toast after a copy action (TXT-GEN-11).
 */
create or modify microflow Shop.ACT_Toast_Copied ()
folder 'Tracking'
begin
  call microflow Shop.SUB_Toast(Message = 'Copied to clipboard.', Level = Shop.ToastLevel.SUCCESS, ShowCartAction = false);
end;
grant execute on microflow Shop.ACT_Toast_Copied to Shop.Guest, Shop.Administrator; -- auto

/**
 * Lookup form data source (SCR-10).
 *
 * @returns An empty lookup form
 */
create or modify microflow Shop.DS_Lookup ()
returns Shop.LookupForm as $Form
folder 'Tracking'
begin
  $Form = create Shop.LookupForm (OrderNumber = '', Email = '', Error = '');
  return $Form;
end;
grant execute on microflow Shop.DS_Lookup to Shop.Guest, Shop.Administrator; -- auto

/**
 * git log --grep (US-133, US-136): finds a guest order by number (MX-1061,
 * mx-1061 or 1061) and contact email, case-insensitive and trimmed. A miss
 * never says which field is wrong; after 5 misses in 10 minutes lookups are
 * refused for 10 minutes. A hit grants this session access and opens SCR-09.
 *
 * @param $Form The lookup form
 */
create or modify microflow Shop.ACT_Lookup ($Form: Shop.LookupForm)
folder 'Tracking'
begin
  declare $Raw String = if $Form/OrderNumber = empty then '' else toUpperCase(trim($Form/OrderNumber));
  declare $Email String = if $Form/Email = empty then '' else toLowerCase(trim($Form/Email));
  if $Raw = '' or $Email = '' then
    change $Form (Error = 'Enter the order number and the email used at checkout.');
    return;
  end if;
  declare $Since DateTime = addMinutes([%CurrentDateTime%], -10);
  retrieve $Misses from Shop.LookupAttempt where [Shop.LookupAttempt_User = '[%CurrentUser%]' and AttemptedAt > $Since];
  $MissCount = count $Misses;
  if $MissCount >= 5 then
    change $Form (Error = 'Too many attempts. Try again in 10 minutes.');
    return;
  end if;
  declare $Digits String = replaceAll(replaceFirst($Raw, '^MX-', ''), '[^0-9]', '');
  declare $Number Integer = if isMatch($Digits, '[0-9]{1,9}') then parseInteger($Digits) else -1;
  retrieve $O from Shop.Order where [OrderNumber = $Number and Source = 'GUEST'] first;
  if $O = empty or toLowerCase($O/ContactEmail) != $Email then
    $Miss = create Shop.LookupAttempt (AttemptedAt = [%CurrentDateTime%], Shop.LookupAttempt_User = [%CurrentUser%]);
    commit $Miss without events;
    change $Form (Error = 'No order matches this order number and email.');
    return;
  end if;
  call microflow Shop.SUB_Order_Grant(TheOrder = $O);
  show page Shop.Tracking(TheOrder = $O);
end;
grant execute on microflow Shop.ACT_Lookup to Shop.Guest, Shop.Administrator; -- auto

/**
 * Data source of the home Live Build Status panel (US-024): the most recent
 * open order of this session, or none.
 *
 * @returns A track view, or empty when the session has no open order
 */
create or modify microflow Shop.DS_Home_Active ()
returns Shop.TrackView as $View
folder 'Home'
begin
  retrieve $Access from Shop.OrderAccess where [Shop.OrderAccess_User = '[%CurrentUser%]' and Shop.OrderAccess_Order/Shop.Order/IsOpen = true] sort by GrantedAt desc first;
  if $Access = empty then
    return empty;
  end if;
  retrieve $O from $Access/Shop.OrderAccess_Order;
  $View = create Shop.TrackView (Shop.TrackView_Order = $O);
  call microflow Shop.SUB_Track_Fill(View = $View);
  return $View;
end;
grant execute on microflow Shop.DS_Home_Active to Shop.Guest, Shop.Administrator; -- auto

/**
 * Back to the cart after a rolled-back order (US-107 AC2).
 */
create or modify microflow Shop.ACT_Pay_ToCart ()
folder 'Tracking'
begin
  close page;
  call microflow Shop.ACT_Nav_Cart();
end;
grant execute on microflow Shop.ACT_Pay_ToCart to Shop.Guest, Shop.Administrator; -- auto

/**
 * Retry from the tracking page (US-113 AC2): opens the payment sheet in its
 * failure state so method and test card can be changed.
 *
 * @param $TheOrder The order
 */
create or modify microflow Shop.ACT_Track_RetryOpen ($TheOrder: Shop.Order)
folder 'Tracking'
begin
  show page Shop.PaymentSheet(TheOrder = $TheOrder);
end;
grant execute on microflow Shop.ACT_Track_RetryOpen to Shop.Guest, Shop.Administrator; -- auto

/** Live log of an order (US-123): customer-visible lines only, oldest first. */
create or modify snippet Shop.SNIP_OrderLog (Params: ($TheOrder: Shop.Order)) {
  listview lvLog (DataSource: DATABASE Shop.OrderLogEntry WHERE [Shop.OrderLogEntry_Order = $TheOrder and IsCustomerVisible = true] SORT BY Seq ASC, PageSize: 500, Class: 'log-lv') {
    container ll (Class: 'log-line') {
      dynamictext llTs (Content: '[{1}]', ContentParams: ({1} = TimeText), Class: 'ts')
      dynamictext llTag (Content: '[{1}]', ContentParams: ({1} = Tag), Class: 'tag', DynamicClasses: if $currentObject/Level = Shop.LogLevel.ERROR then 'tag-error' else if $currentObject/Level = Shop.LogLevel.WARN then 'tag-warn' else if $currentObject/Level = Shop.LogLevel.SUCCESS then 'tag-success' else if $currentObject/Tag = 'PAYMENT' or $currentObject/Tag = 'ROUTER' or $currentObject/Tag = 'COURIER' then 'tag-info' else if $currentObject/Tag = 'QA' then 'tag-qa' else if $currentObject/Tag = 'INIT' then 'tag-success' else 'tag-orange')
      dynamictext llMsg (Content: '{1}', ContentParams: ({1} = Message), Class: 'msg')
    }
  }
};

/** Five-stage pipeline stepper (US-122). */
create or modify snippet Shop.SNIP_Stepper (Params: ($View: Shop.TrackView)) {
  container pipeline (Class: 'pipeline') {
    container fill (Class: 'fill', DynamicClasses: 'fill-' + toString($View/FillBucket)) { }
    container st1 (Class: 'pipe-step', DynamicClasses: $View/S1) {
      container n1 (Class: 'node') { dynamictext n1i (Content: '{1}', ContentParams: ({1} = if $View/S1 = 'done' then 'check' else 'inventory'), Class: 'ms') }
      dynamictext l1 (Content: '1. QUEUED', Class: 'lbl')
      dynamictext u1 (Content: '{1}', ContentParams: ({1} = if $View/S1 = 'done' then $View/T1 else 'Order received'), Class: 'sub')
    }
    container st2 (Class: 'pipe-step', DynamicClasses: $View/S2) {
      container n2 (Class: 'node') { dynamictext n2i (Content: '{1}', ContentParams: ({1} = if $View/S2 = 'done' then 'check' else 'local_pizza'), Class: 'ms') }
      dynamictext l2 (Content: '2. BAKING', Class: 'lbl')
      dynamictext u2 (Content: '{1}', ContentParams: ({1} = if $View/S2 = 'done' then $View/T2 else 'In the oven'), Class: 'sub')
    }
    container st3 (Class: 'pipe-step', DynamicClasses: $View/S3) {
      container n3 (Class: 'node') { dynamictext n3i (Content: '{1}', ContentParams: ({1} = if $View/S3 = 'done' then 'check' else 'fact_check'), Class: 'ms') }
      dynamictext l3 (Content: '3. QA_CHECK', Class: 'lbl')
      dynamictext u3 (Content: '{1}', ContentParams: ({1} = if $View/S3 = 'done' then $View/T3 else 'Quality check'), Class: 'sub')
    }
    container st4 (Class: 'pipe-step', DynamicClasses: $View/S4) {
      container n4 (Class: 'node') { dynamictext n4i (Content: '{1}', ContentParams: ({1} = if $View/S4 = 'done' then 'check' else if $View/IsDelivery then 'local_shipping' else 'storefront'), Class: 'ms') }
      dynamictext l4 (Content: '4. {1}', ContentParams: ({1} = $View/S4Label), Class: 'lbl')
      dynamictext u4 (Content: '{1}', ContentParams: ({1} = if $View/S4 = 'done' then $View/T4 else $View/S4Sub), Class: 'sub')
    }
    container st5 (Class: 'pipe-step', DynamicClasses: $View/S5) {
      container n5 (Class: 'node') { dynamictext n5i (Content: '{1}', ContentParams: ({1} = if $View/S5 = 'done' then 'check' else 'done_all'), Class: 'ms') }
      dynamictext l5 (Content: '5. {1}', ContentParams: ({1} = $View/S5Label), Class: 'lbl')
      dynamictext u5 (Content: '{1}', ContentParams: ({1} = if $View/S5 = 'done' then $View/T5 else $View/S5Sub), Class: 'sub')
    }
  }
};

/** Home Live Build Status panel (US-024). */
create or modify snippet Shop.SNIP_HomeActiveOrder {
  dataview dvActive (DataSource: MICROFLOW Shop.DS_Home_Active, Class: 'active-dv') {
    container activePanel (Class: 'panel panel-pad active-order', Visible: $currentObject/Shop.TrackView_Order != empty) {
      container apHead (Class: 'between') {
        dynamictext apTitle (Content: 'Live Build Status: Order {1}', ContentParams: ({1} = NumberText), RenderMode: H2, Class: 't-h3')
        dynamictext apBadge (Content: '● {1}', ContentParams: ({1} = StatusDev), Class: 'badge', DynamicClasses: $currentObject/StatusCls)
      }
      dynamictext apBanner (Content: '{1}', ContentParams: ({1} = BannerTitle), Class: 't-small c-warn', Visible: $currentObject/BannerKind = 'failed' or $currentObject/BannerKind = 'pending')
      snippetcall apStepper (Snippet: Shop.SNIP_Stepper, Params: (View = $currentObject))
      container apFoot (Class: 'between mt-16') {
        dynamictext apEta (Content: '{1}{2}', ContentParams: ({1} = if $currentObject/IsDelivery then 'Est. completion: ' else 'Ready at: ', {2} = EtaClock), Class: 't-small c-secondary')
        linkbutton apMonitor (Caption: 'MONITOR PIPELINE →', Action: CALL MICROFLOW Shop.ACT_Track_OpenView(View = $currentObject), Class: 'c-primary')
      }
      container apPoll (Class: 'gp-poll', OnClick: CALL MICROFLOW Shop.ACT_Track_Refresh(View = $currentObject)) { }
    }
  }
};

/** SCR-07 PAYMENT_PROTOCOL sheet: processing, failure with retry/cancel, rolled back (US-102..US-108). */
create or modify page Shop.PaymentSheet (
  Title: 'Payment',
  Layout: Shop.Layout_Modal,
  Params: ($TheOrder: Shop.Order)
) {
  dataview dvPay (DataSource: MICROFLOW Shop.DS_Track(TheOrder = $TheOrder), Class: 'scr-07 pay-sheet') {
    container head (Class: 'modal-head') {
      dynamictext hIcon (Content: '{1}', ContentParams: ({1} = if $currentObject/PayState = 'processing' then 'sync' else if $currentObject/PayState = 'failed' then 'error' else 'undo'), Class: 'ms c-primary')
      container hText (Class: 'h-text') {
        dynamictext hSub (Content: 'PAYMENT_PROTOCOL · MX-{1} · #{2}', ContentParams: ({1} = toString($TheOrder/OrderNumber), {2} = $TheOrder/CommitHash), Class: 't-micro c-muted')
        dynamictext hTitle (Content: '{1}', ContentParams: ({1} = if $currentObject/PayState = 'processing' then 'Processing payment…' else if $currentObject/PayState = 'failed' then 'ERROR 402 // PAYMENT_FAILED' else 'Order rolled back'), RenderMode: H2, Class: 't-h3', DynamicClasses: if $currentObject/PayState = 'failed' or $currentObject/PayState = 'rolledback' then 'c-error' else '')
      }
      dynamictext hSim (Content: 'SIMULATED', Class: 'chip tag-badge')
    }
    container body (Class: 'modal-body') {
      container processing (Visible: $currentObject/PayState = 'processing') {
        container chargeRow (Class: 'between') {
          container chargeTxt {
            dynamictext ct1 (Content: 'Charging {1} to {2}', ContentParams: ({1} = AmountText, {2} = MethodLabel), Class: 'charge')
            dynamictext ct2 (Content: '{1} · do not close this window', ContentParams: ({1} = AttemptText), Class: 't-micro c-muted mt-8')
          }
        }
        container progress (Class: 'progress orange mt-16 indeterminate') { container progressBar (Class: 'bar') { } }
      }
      container failed (Visible: $currentObject/PayState = 'failed') {
        container failNote (Class: 'notice error') {
          dynamictext fnI (Content: 'error', Class: 'ms')
          dynamictext fnT (Content: '{1}', ContentParams: ({1} = FailureText))
        }
        dataview dvRetryForm (DataSource: MICROFLOW Shop.SUB_Checkout_Current, Class: 'retry-dv') {
          snippetcall retryChoice (Snippet: Shop.SNIP_PaymentChoice, Params: (Form = $currentObject))
        }
      }
      container rolled (Visible: $currentObject/PayState = 'rolledback') {
        container rbNote (Class: 'notice error') {
          dynamictext rbI (Content: 'undo', Class: 'ms')
          dynamictext rbT (Content: '{1} {2} Your manifest is unchanged.', ContentParams: ({1} = BannerTitle, {2} = BannerText))
        }
      }
      container logTerm (Class: 'term mt-16') {
        container ltBar (Class: 'term-bar') {
          container ltDots (Class: 'dots') { container ld1 (Class: 'dot') { } container ld2 (Class: 'dot') { } container ld3 (Class: 'dot') { } }
          dynamictext ltName (Content: 'bash — payment.log')
        }
        container ltBody (Class: 'term-body') {
          snippetcall ltLog (Snippet: Shop.SNIP_OrderLog, Params: (TheOrder = $TheOrder))
        }
      }
    }
    container foot (Class: 'modal-foot') {
      actionbutton fCancelDis (Caption: 'Cancel order', Action: NOTHING, Class: 'btn btn-ghost is-disabled', Visible: $currentObject/PayState = 'processing')
      container fProc (Class: 'btn btn-primary is-disabled', Visible: $currentObject/PayState = 'processing') { dynamictext fProcI (Content: 'hourglass_top', Class: 'ms') dynamictext fProcT (Content: 'Processing…') }
      container fCancel (Class: 'btn btn-danger', Visible: $currentObject/PayState = 'failed', OnClick: CALL MICROFLOW Shop.ACT_Pay_CancelAndCart(View = $currentObject) with (Confirmation: 'Cancel this order? Nothing was charged.', ProceedCaption: 'Cancel order', CancelCaption: 'Keep order')) { dynamictext fCancelT (Content: 'Cancel order') }
      container fRetry (Class: 'btn btn-primary', Visible: $currentObject/PayState = 'failed', OnClick: CALL MICROFLOW Shop.ACT_Pay_Retry(View = $currentObject)) { dynamictext fRetryI (Content: 'refresh', Class: 'ms') dynamictext fRetryT (Content: 'Retry payment') }
      container fBack (Class: 'btn btn-primary', Visible: $currentObject/PayState = 'rolledback' or $currentObject/PayState = 'success', OnClick: CALL MICROFLOW Shop.ACT_Pay_ToCart) { dynamictext fBackT (Content: 'Back to MANIFEST.LOCK') }
    }
    container payPoll (Class: 'gp-poll', OnClick: CALL MICROFLOW Shop.ACT_Pay_Refresh(View = $currentObject)) { }
  }
};


/** SCR-08 DEPLOYMENT SUCCESSFUL // 200 OK (US-110). */
create or modify page Shop.Confirmation (
  Title: 'Order confirmation',
  Layout: Shop.Layout_Modal,
  Params: ($TheOrder: Shop.Order)
) {
  dataview dvConf (DataSource: MICROFLOW Shop.DS_Track(TheOrder = $TheOrder), Class: 'scr-08 conf-sheet') {
    container cbar (Class: 'term-bar') {
      container cdots (Class: 'dots') { container cd1 (Class: 'dot') { } container cd2 (Class: 'dot') { } container cd3 (Class: 'dot') { } }
      dynamictext cTty (Content: 'tty: deploy-runner · mission-kitchen')
      dynamictext cHttp (Content: 'HTTP 200 OK', Class: 'chip tag-badge c-right')
    }
    container cbody (Class: 'modal-body') {
      container hero (Class: 'conf-hero') {
        container okIcon (Class: 'ok-icon') { image okImg (ImageType: imageUrl, ImageUrl: '/assets/brand/logo-mark.svg', AlternativeText: '', Class: 'ok-img') }
        container heroText {
          container heroKey (Class: 'hero-key') { container hkDot (Class: 'live-dot') { } dynamictext hkT (Content: 'DEPLOYMENT SUCCESSFUL // 200 OK', Class: 'c-green t-label') }
          dynamictext heroH (Content: 'Order placed and paid', RenderMode: H2, Class: 't-h1')
          dynamictext heroP (Content: 'The kitchen accepted your order. {1}', ContentParams: ({1} = if $currentObject/QueueText = '' then 'It is moving through the pipeline.' else $currentObject/QueueText + '.'), Class: 't-body-long')
        }
      }
      container hashbox (Class: 'hashbox mt-16') {
        dynamictext hbI (Content: 'fingerprint', Class: 'ms c-primary')
        dynamictext hbL (Content: 'DEPLOYMENT_HASH:', Class: 'hb-l')
        dynamictext hbV (Content: '#{1}', ContentParams: ({1} = $TheOrder/CommitHash), Class: 'c-green hb-v')
        dynamictext hbO (Content: '· order MX-{1}', ContentParams: ({1} = toString($TheOrder/OrderNumber)), Class: 't-small c-muted')
        container hbCopy (Class: 'btn btn-ghost btn-sm hb-copy', OnClick: CALL NANOFLOW Shop.NF_CopyHash(View = $currentObject)) { dynamictext hbCopyI (Content: 'content_copy', Class: 'ms sm') dynamictext hbCopyT (Content: 'COPY HASH') }
      }
      container tiles (Class: 'tiles mt-16') {
        container tile1 (Class: 'tile') {
          container t1h (Class: 'between') { dynamictext t1l (Content: 'ESTIMATED_DELIVERY', Class: 't-label c-secondary') dynamictext t1i (Content: 'schedule', Class: 'ms c-primary') }
          dynamictext t1v (Content: 'ETA {1}', ContentParams: ({1} = EtaCountdown), Class: 'tile-big c-primary')
          dynamictext t1s (Content: '{1} at about {2} · demo time', ContentParams: ({1} = if $currentObject/IsDelivery then 'Delivered' else 'Ready', {2} = EtaClock), Class: 't-small c-muted')
        }
        container tile2 (Class: 'tile') {
          container t2h (Class: 'between') { dynamictext t2l (Content: 'HARDWARE_CLUSTER', Class: 't-label c-secondary') dynamictext t2i (Content: 'local_fire_department', Class: 'ms c-primary') }
          dynamictext t2v (Content: 'Oven assigned when baking starts', Class: 'tile-mid')
          dynamictext t2s (Content: '● {1}', ContentParams: ({1} = OvenSummary), Class: 't-small c-green')
        }
        container tile3 (Class: 'tile') {
          container t3h (Class: 'between') { dynamictext t3l (Content: 'TX_PROTOCOL', Class: 't-label c-secondary') dynamictext t3i (Content: 'verified_user', Class: 'ms c-green') }
          dynamictext t3v (Content: '{1}', ContentParams: ({1} = MethodLabel), Class: 'tile-mid c-green')
          dynamictext t3s (Content: 'STATUS: PAID // {1}', ContentParams: ({1} = TotalText), Class: 't-small')
          dynamictext t3t (Content: 'TxID {1} (simulated)', ContentParams: ({1} = TxnText), Class: 't-micro c-muted')
        }
      }
      container stream (Class: 'term mt-16') {
        container sBar (Class: 'term-bar') { dynamictext sBarI (Content: 'terminal', Class: 'ms sm c-green') dynamictext sBarT (Content: 'PIPELINE_STREAMS // STDOUT') container sLive (Class: 'c-green live-tag2') { container sDot (Class: 'live-dot') { } dynamictext sLiveT (Content: 'LIVE') } }
        container sBody (Class: 'term-body') { snippetcall sLog (Snippet: Shop.SNIP_OrderLog, Params: (TheOrder = $TheOrder)) }
      }
      container link (Class: 'panel panel-pad mt-16') {
        container lH (Class: 'section-label') { dynamictext lHI (Content: 'link', Class: 'ms') dynamictext lHT (Content: 'TRACKING_LINK') }
        dynamictext lP (Content: 'Save this link to follow your order. You can also find it with your order number and email: MX-{1} and {2}.', ContentParams: ({1} = toString($TheOrder/OrderNumber), {2} = $TheOrder/ContactEmail), Class: 't-small c-secondary')
        container lRow (Class: 'link-row mt-8') {
          dynamictext lUrl (Content: '{1}', ContentParams: ({1} = TrackingUrl), Class: 'input link-url')
          container lCopy (Class: 'btn btn-ghost', OnClick: CALL NANOFLOW Shop.NF_CopyLink(View = $currentObject)) { dynamictext lCopyI (Content: 'content_copy', Class: 'ms') }
        }
        dynamictext lNote (Content: 'We use your email only to let you look up this order. No emails are sent in this demo.', Class: 't-micro c-muted mt-8')
      }
    }
    container cfoot (Class: 'modal-foot') {
      container fReceipt (Class: 'btn btn-ghost', OnClick: CALL MICROFLOW Shop.ACT_Receipt_Open(TheOrder = $TheOrder)) { dynamictext fRI (Content: 'receipt_long', Class: 'ms') dynamictext fRT (Content: 'View receipt') }
      container fMonitor (Class: 'btn btn-primary', OnClick: CALL MICROFLOW Shop.ACT_Track_Open(TheOrder = $TheOrder)) { dynamictext fMI (Content: 'monitoring', Class: 'ms') dynamictext fMT (Content: 'MONITOR PIPELINE →') }
    }
    container confPoll (Class: 'gp-poll', OnClick: CALL MICROFLOW Shop.ACT_Track_Refresh(View = $currentObject)) { }
  }
};

/** SCR-09 DEPLOYMENT_STATUS (EP-07). */
create or modify page Shop.Tracking (
  Title: 'Order tracking — Git Pizza MxDev',
  Layout: Shop.Layout_Guest,
  Params: ($TheOrder: Shop.Order)
) {
  dataview dvTrack (DataSource: MICROFLOW Shop.DS_Track(TheOrder = $TheOrder), Class: 'page-dv') {
    container page (Class: 'page scr-09') {
      container trkHead (Class: 'trk-head') {
        container thLeft {
          dynamictext thPath (Content: './track.log', Class: 't-micro c-muted')
          dynamictext thTitle (Content: 'DEPLOYMENT_STATUS', RenderMode: H1, Class: 't-display c-primary')
          container thMeta (Class: 'meta t-small') {
            dynamictext m1 (Content: 'ORDER: ')
            dynamictext m2 (Content: 'MX-{1}', ContentParams: ({1} = toString($TheOrder/OrderNumber)), Class: 'c-orange')
            dynamictext m3 (Content: ' | COMMIT: ')
            dynamictext m4 (Content: '#{1}', ContentParams: ({1} = $TheOrder/CommitHash), Class: 'c-green')
            dynamictext m5 (Content: ' | PLACED: {1} | {2}', ContentParams: ({1} = PlacedText, {2} = TypeText))
          }
        }
        container thRight (Class: 'row th-right') {
          dynamictext thBadge (Content: '● {1}', ContentParams: ({1} = StatusDev), Class: 'badge', DynamicClasses: $currentObject/StatusCls)
          dynamictext thPlain (Content: '{1}', ContentParams: ({1} = StatusPlain), Class: 'c-secondary')
          container thLive (Class: 'chip tag-badge', Visible: not($currentObject/IsFinal)) { container thLiveDot (Class: 'live-dot') { } dynamictext thLiveT (Content: 'LIVE PIPELINE MONITORING') }
        }
      }
      container banner (Class: 'notice mt-16 trk-banner', DynamicClasses: if $currentObject/BannerKind = 'failed' or $currentObject/BannerKind = 'cancelled' then 'error' else if $currentObject/BannerKind = 'pending' then 'warn' else 'success', Visible: $currentObject/BannerKind != 'none') {
        dynamictext bnI (Content: '{1}', ContentParams: ({1} = if $currentObject/BannerKind = 'done' then 'check_circle' else if $currentObject/BannerKind = 'ready' then 'storefront' else if $currentObject/BannerKind = 'pending' then 'hourglass_top' else 'error'), Class: 'ms')
        container bnBody {
          dynamictext bnT (Content: '{1}', ContentParams: ({1} = BannerTitle), Class: 'bn-title')
          dynamictext bnX (Content: '{1}', ContentParams: ({1} = BannerText))
          dynamictext bnR (Content: '{1}', ContentParams: ({1} = RefundLine), Visible: $currentObject/RefundLine != '')
          container bnActions (Class: 'row mt-8', Visible: $currentObject/CanRetry) {
            container bnRetry (Class: 'btn btn-primary btn-sm', OnClick: CALL MICROFLOW Shop.ACT_Track_RetryOpen(TheOrder = $TheOrder)) { dynamictext bnRetryT (Content: 'Retry payment') }
            container bnCancel (Class: 'btn btn-danger btn-sm', OnClick: CALL MICROFLOW Shop.ACT_Pay_Cancel(View = $currentObject) with (Confirmation: 'Cancel this order? Nothing was charged.', ProceedCaption: 'Cancel order', CancelCaption: 'Keep order')) { dynamictext bnCancelT (Content: 'Cancel order') }
          }
        }
      }
      container trk (Class: 'trk') {
        container trkLeft (Class: 'stack-lg') {
          container pipePanel (Class: 'panel panel-pad') {
            dynamictext ppH (Content: 'PIPELINE WORKFLOW', Class: 't-label c-secondary pp-h')
            snippetcall stepper (Snippet: Shop.SNIP_Stepper, Params: (View = $currentObject))
            container detail (Class: 'stage-detail mt-16', Visible: $currentObject/ShowProgress) {
              dynamictext dT (Content: '{1}', ContentParams: ({1} = ProgressText))
              container dBar (Class: 'progress orange') { container dFill (Class: 'pfill', DynamicClasses: 'pw-' + toString($currentObject/ProgressBucket)) { } }
            }
          }
          container logTerm (Class: 'term') {
            container lBar (Class: 'term-bar') {
              container lDots (Class: 'dots') { container l1 (Class: 'dot') { } container l2 (Class: 'dot') { } container l3 (Class: 'dot') { } }
              dynamictext lName (Content: 'bash — track.log', Class: 'c-right')
            }
            container lBody (Class: 'term-body logbox') {
              snippetcall log (Snippet: Shop.SNIP_OrderLog, Params: (TheOrder = $TheOrder))
              container prompt (Class: 'prompt-line') { dynamictext pr1 (Content: 'mxdev@pizza:~$ ', Class: 'c-green') container prC (Class: 'cursor') { } }
            }
          }
        }
        container trkRight (Class: 'stack-lg') {
          container geo (Class: 'panel geo', Visible: $currentObject/IsDelivery) {
            container geoH (Class: 'between geo-h') { dynamictext geoT (Content: 'GEOLOCATION', Class: 't-label') dynamictext geoM (Content: '{1}', ContentParams: ({1} = MapMode), Class: 'chip') }
            container mapWell (Class: 'map-well') {
              image mapBase (ImageType: imageUrl, ImageUrl: '/assets/illustrations/map-sf-dark.jpg', AlternativeText: 'Simulated map of San Francisco', Class: 'map-base')
              container route (Class: 'map-route') { }
              container pinStore (Class: 'map-pin store') { container psMk (Class: 'mk') { dynamictext psI (Content: 'local_pizza', Class: 'ms sm') } dynamictext psN (Content: 'MISSION_KITCHEN', Class: 'nm') }
              container pinDest (Class: 'map-pin dest') { container pdMk (Class: 'mk') { dynamictext pdI (Content: 'location_on', Class: 'ms sm') } dynamictext pdN (Content: '{1}', ContentParams: ({1} = $TheOrder/AddressLine1), Class: 'nm') }
              container pinCourier (Class: 'map-pin courier', DynamicClasses: 'cpos-' + toString($currentObject/CourierBucket), Visible: $currentObject/MapMode != 'STANDBY') { container pcMk (Class: 'mk') { dynamictext pcI (Content: 'electric_moped', Class: 'ms sm') } }
              dynamictext mapHelper (Content: '{1}', ContentParams: ({1} = MapHelper), Class: 'map-helper', Visible: $currentObject/MapHelper != '')
            }
            container etaRow (Class: 'eta-row', Visible: $currentObject/ShowEta) {
              container etaL {
                dynamictext etaLbl (Content: '{1}', ContentParams: ({1} = EtaLabel), Class: 't-label')
                dynamictext etaV (Content: '{1}', ContentParams: ({1} = EtaCountdown), Class: 'eta-big c-green')
                dynamictext etaC (Content: '{1} · demo time', ContentParams: ({1} = EtaClock), Class: 't-micro c-muted')
              }
              container etaR (Class: 'eta-r') {
                dynamictext distL (Content: 'DISTANCE_REMAINING', Class: 't-label')
                dynamictext distV (Content: '{1}', ContentParams: ({1} = DistanceText))
              }
            }
            container courier (Class: 'courier', Visible: $currentObject/ShowCourier) {
              container av (Class: 'av') { dynamictext avI (Content: 'electric_moped', Class: 'ms') }
              container cText {
                dynamictext cName (Content: '{1}', ContentParams: ({1} = CourierText), Class: 'c-primary')
                dynamictext cStat (Content: '{1}', ContentParams: ({1} = CourierStatus), Class: 't-micro c-muted')
              }
            }
          }
          container pickupPanel (Class: 'panel panel-pad', Visible: not($currentObject/IsDelivery)) {
            container puH (Class: 'section-label') { dynamictext puI (Content: 'storefront', Class: 'ms') dynamictext puT (Content: 'Pickup') }
            dynamictext puTxt (Content: '{1}', ContentParams: ({1} = PickupText), Class: 't-small c-secondary')
            dynamictext puReady (Content: '{1}', ContentParams: ({1} = ReadyText), Class: 't-small c-green mt-8', Visible: $currentObject/ShowEta)
          }
          container cfg (Class: 'panel panel-pad') {
            container cfgH (Class: 'section-label') { dynamictext cfgI (Content: 'inventory_2', Class: 'ms') dynamictext cfgT (Content: 'Order configuration') }
            listview lvLines (DataSource: DATABASE Shop.OrderLine WHERE [Shop.OrderLine_Order = $TheOrder] SORT BY SortOrder ASC, PageSize: 200, Class: 'ord-lv') {
              container ol (Class: 'ord-line') {
                container olL {
                  dynamictext olN (Content: '{1}× {2}', ContentParams: ({1} = Quantity, {2} = ProductName), Class: 'c-primary')
                  dynamictext olS (Content: '{1}{2}', ContentParams: ({1} = SizeLabel, {2} = if $currentObject/ConfigText = empty or $currentObject/ConfigText = '' then '' else ' · ' + $currentObject/ConfigText), Class: 't-micro c-muted')
                }
                dynamictext olT (Content: '${1}', ContentParams: ({1} = LineTotal format (decimalPrecision: 2, groupDigits: true)))
              }
            }
            container sumRows (Class: 'mt-8') {
              container rSub (Class: 'sum-row') { dynamictext rSubL (Content: 'Subtotal', Class: 'lbl') dynamictext rSubV (Content: '{1}', ContentParams: ({1} = SubText)) }
              container rDisc (Class: 'sum-row discount', Visible: $TheOrder/DiscountAmount > 0) { dynamictext rDiscL (Content: 'Discount ({1})', ContentParams: ({1} = $TheOrder/CouponCode), Class: 'lbl') dynamictext rDiscV (Content: '{1}', ContentParams: ({1} = DiscText)) }
              container rFee (Class: 'sum-row', Visible: $TheOrder/OrderType = Shop.OrderType.DELIVERY) { dynamictext rFeeL (Content: 'Delivery fee', Class: 'lbl') dynamictext rFeeV (Content: '{1}', ContentParams: ({1} = FeeText)) }
              container rTax (Class: 'sum-row') { dynamictext rTaxL (Content: 'Sales tax 8.625 %', Class: 'lbl') dynamictext rTaxV (Content: '{1}', ContentParams: ({1} = TaxText)) }
              container rTip (Class: 'sum-row', Visible: $TheOrder/OrderType = Shop.OrderType.DELIVERY) { dynamictext rTipL (Content: 'Courier tip', Class: 'lbl') dynamictext rTipV (Content: '{1}', ContentParams: ({1} = TipText)) }
              dynamictext rPay (Content: 'Paid with {1}', ContentParams: ({1} = MethodLabel), Class: 't-micro c-muted')
              dynamictext rAddr (Content: '{1}', ContentParams: ({1} = AddressText), Class: 't-micro c-muted')
            }
            container cost (Class: 'sum-total') { dynamictext costL (Content: 'DEPLOYMENT_COST', Class: 't-label') dynamictext costV (Content: '{1}', ContentParams: ({1} = TotalText), Class: 't-price-lg c-primary') }
            container receipt (Class: 'btn btn-ghost btn-sm mt-16', OnClick: CALL MICROFLOW Shop.ACT_Receipt_Open(TheOrder = $TheOrder)) { dynamictext rcI (Content: 'receipt_long', Class: 'ms sm') dynamictext rcT (Content: 'View receipt') }
            container rollback (Class: 'rollback mt-16', Visible: $currentObject/ShowRollback) {
              container rbBtn (Class: 'btn btn-danger btn-block', DynamicClasses: if $currentObject/CanRollback then '' else 'is-disabled', OnClick: CALL MICROFLOW Shop.ACT_Track_Rollback(View = $currentObject) with (Confirmation: 'Roll back this order? It will be cancelled and the full amount refunded (simulated).', ProceedCaption: 'Rollback order', CancelCaption: 'Keep order')) { dynamictext rbT (Content: 'Rollback order') }
              dynamictext rbMsg (Content: '{1}', ContentParams: ({1} = RollbackMsg), Class: 't-small c-error mt-8', Visible: not($currentObject/CanRollback))
            }
          }
        }
      }
      container trkPoll (Class: 'gp-poll', OnClick: CALL MICROFLOW Shop.ACT_Track_Refresh(View = $currentObject)) { }
    }
  }
};


/** SCR-09 invalid-link state (US-134). */
create or modify page Shop.TrackInvalid (
  Title: 'Order tracking — Git Pizza MxDev',
  Layout: Shop.Layout_Guest,
  Url: 'track-invalid'
) {
  container page (Class: 'page scr-09 scr-09-invalid') {
    container box (Class: 'panel panel-pad invalid-box') {
      dynamictext iT (Content: 'ERROR 404 // DEPLOYMENT_NOT_FOUND', RenderMode: H1, Class: 't-h1 c-error')
      dynamictext iP (Content: 'This tracking link is not valid any more. It may have been mistyped, or the demo data was reset. Find your order with its number and email instead.', Class: 't-body-long mt-8')
      container iBtns (Class: 'row mt-16') {
        actionbutton iLookup (Caption: 'git log --grep', Action: SHOW PAGE Shop.TrackLookup, Class: 'btn btn-primary')
        actionbutton iHome (Caption: 'RETURN_TO_MAIN', Action: CALL MICROFLOW Shop.ACT_Nav_Home, Class: 'btn btn-secondary')
      }
    }
  }
};

/** SCR-10 git log --grep (US-133). */
create or modify page Shop.TrackLookup (
  Title: 'Find your order — Git Pizza MxDev',
  Layout: Shop.Layout_Guest,
  Url: 'track'
) {
  dataview dvLookup (DataSource: MICROFLOW Shop.DS_Lookup, Class: 'page-dv') {
    container page (Class: 'page scr-10') {
      dynamictext lPath (Content: './track.log', Class: 't-micro c-muted')
      dynamictext lTitle (Content: 'git log --grep', RenderMode: H1, Class: 't-h1 c-primary')
      dynamictext lIntro (Content: 'Find your order with its number and the email you used at checkout. You will find both in the confirmation.', Class: 't-body-long mt-8 l-intro')
      container lPanel (Class: 'panel panel-pad lookup-panel') {
        container fNo (Class: 'field') {
          dynamictext fNoL (Content: 'ORDER_NUMBER', Class: 'field-label')
          textbox tNo (Attribute: OrderNumber, Placeholder: 'MX-1064', Class: 'gp-input')
          dynamictext fNoH (Content: 'Format MX- followed by digits', Class: 'hint')
        }
        container fEm (Class: 'field mt-16') {
          dynamictext fEmL (Content: 'CONTACT_EMAIL', Class: 'field-label')
          textbox tEm (Attribute: Email, Placeholder: 'you@example.com', OnEnterKeyPress: CALL MICROFLOW Shop.ACT_Lookup(Form = $currentObject), Class: 'gp-input')
        }
        container lErr (Class: 'field-error mt-16', Visible: $currentObject/Error != empty and $currentObject/Error != '') {
          dynamictext lErrI (Content: 'error', Class: 'ms sm')
          dynamictext lErrT (Content: '{1}', ContentParams: ({1} = Error))
        }
        container lBtn (Class: 'btn btn-primary btn-lg btn-block mt-16', OnClick: CALL MICROFLOW Shop.ACT_Lookup(Form = $currentObject)) { dynamictext lBtnI (Content: 'search', Class: 'ms') dynamictext lBtnT (Content: 'git log --grep') }
      }
    }
  }
};

/** SCR-13 git show <hash>: order detail and receipt (US-166, US-167). */
create or modify page Shop.Receipt (
  Title: 'Receipt — Git Pizza MxDev',
  Layout: Shop.Layout_Guest,
  Params: ($TheOrder: Shop.Order)
) {
  dataview dvRec (DataSource: MICROFLOW Shop.DS_Track(TheOrder = $TheOrder), Class: 'page-dv') {
    container page (Class: 'page scr-13 print-area') {
      container rTop (Class: 'between no-print') {
        linkbutton rBack (Caption: '← back to tracking', Action: SHOW PAGE Shop.Tracking(TheOrder = $TheOrder), Class: 't-small c-primary')
        container rPrint (Class: 'btn btn-ghost btn-sm', OnClick: CALL NANOFLOW Shop.NF_Print) { dynamictext rPI (Content: 'print', Class: 'ms sm') dynamictext rPT (Content: 'Print receipt') }
      }
      dynamictext rCmd (Content: '$ git show {1}', ContentParams: ({1} = $TheOrder/CommitHash), Class: 't-micro c-muted mt-16')
      container rTitle (Class: 'r-title') {
        dynamictext rT1 (Content: 'commit {1}', ContentParams: ({1} = $TheOrder/CommitHash), RenderMode: H1, Class: 't-h1 c-green')
        dynamictext rT2 (Content: ' (MX-{1})', ContentParams: ({1} = toString($TheOrder/OrderNumber)), Class: 'c-muted')
      }
      dynamictext rAuthor (Content: 'Author: {1} <{2}>', ContentParams: ({1} = $TheOrder/ContactName, {2} = $TheOrder/ContactEmail), Class: 't-small')
      dynamictext rDate (Content: 'Date: {1} (America/Los_Angeles) · {2}', ContentParams: ({1} = PlacedText, {2} = TypeText), Class: 't-small')
      container rStatus (Class: 'row mt-8') { dynamictext rSB (Content: '● {1}', ContentParams: ({1} = StatusDev), Class: 'badge', DynamicClasses: $currentObject/StatusCls) dynamictext rSP (Content: '{1}', ContentParams: ({1} = StatusPlain), Class: 'c-secondary') }
      container det (Class: 'det') {
        container detLeft (Class: 'panel panel-pad') {
          container th (Class: 'r-row r-head') { dynamictext th1 (Content: 'Module') dynamictext th2 (Content: 'Qty', Class: 'num') dynamictext th3 (Content: 'Unit', Class: 'num') dynamictext th4 (Content: 'Total', Class: 'num') }
          listview lvRLines (DataSource: DATABASE Shop.OrderLine WHERE [Shop.OrderLine_Order = $TheOrder] SORT BY SortOrder ASC, PageSize: 200, Class: 'rlines-lv') {
            container rl (Class: 'r-row') {
              container rlInfo {
                dynamictext rlN (Content: '{1}', ContentParams: ({1} = ProductName), Class: 'c-primary b')
                dynamictext rlS (Content: '{1} · {2}', ContentParams: ({1} = RealWorldName, {2} = SizeLabel), Class: 't-micro c-muted')
                listview lvMods (DataSource: DATABASE Shop.OrderLineModifier WHERE [Shop.OrderLineModifier_OrderLine = $currentObject] SORT BY SortOrder ASC, PageSize: 50, Class: 'mods-lv') {
                  dynamictext md (Content: '{1}{2}{3}{4}', ContentParams: ({1} = if $currentObject/ModifierType = Shop.ModifierType.ADD then '+ ' else if $currentObject/ModifierType = Shop.ModifierType.REMOVE then '− ' else getKey($currentObject/ModifierType) + ': ', {2} = Name, {3} = if $currentObject/IsDefault then ' (default)' else '', {4} = if $currentObject/Price > 0 then ' +$' + toString($currentObject/Price) else ''), Class: 'mod', DynamicClasses: if $currentObject/ModifierType = Shop.ModifierType.ADD then 'add' else if $currentObject/ModifierType = Shop.ModifierType.REMOVE then 'rem' else '')
                }
                dynamictext rlA (Content: 'Allergens: {1}', ContentParams: ({1} = AllergenText), Class: 't-micro c-muted')
              }
              dynamictext rlQ (Content: '{1}', ContentParams: ({1} = Quantity), Class: 'num')
              dynamictext rlU (Content: '${1}', ContentParams: ({1} = UnitPrice format (decimalPrecision: 2, groupDigits: true)), Class: 'num')
              dynamictext rlT (Content: '${1}', ContentParams: ({1} = LineTotal format (decimalPrecision: 2, groupDigits: true)), Class: 'num')
            }
          }
          container totals (Class: 'r-totals') {
            container tSub (Class: 'sum-row') { dynamictext tSubL (Content: 'Subtotal', Class: 'lbl') dynamictext tSubV (Content: '{1}', ContentParams: ({1} = SubText)) }
            container tDisc (Class: 'sum-row discount', Visible: $TheOrder/DiscountAmount > 0) { dynamictext tDiscL (Content: 'Discount ({1})', ContentParams: ({1} = $TheOrder/CouponCode), Class: 'lbl') dynamictext tDiscV (Content: '{1}', ContentParams: ({1} = DiscText)) }
            container tFee (Class: 'sum-row') { dynamictext tFeeL (Content: 'Delivery fee', Class: 'lbl') dynamictext tFeeV (Content: '{1}', ContentParams: ({1} = FeeText)) }
            container tTax (Class: 'sum-row') { dynamictext tTaxL (Content: 'Sales tax 8.625 %', Class: 'lbl') dynamictext tTaxV (Content: '{1}', ContentParams: ({1} = TaxText)) }
            container tTip (Class: 'sum-row') { dynamictext tTipL (Content: 'Courier tip {1}', ContentParams: ({1} = TipLabel), Class: 'lbl') dynamictext tTipV (Content: '{1}', ContentParams: ({1} = TipText)) }
            container tTot (Class: 'sum-total') { dynamictext tTotL (Content: 'TOTAL', Class: 't-label') dynamictext tTotV (Content: '{1}', ContentParams: ({1} = TotalText), Class: 't-price-lg c-primary') }
            dynamictext tNote (Content: 'Prices are a snapshot from the time of ordering and never change afterwards.', Class: 't-micro c-muted mt-8')
          }
        }
        container detRight (Class: 'stack') {
          container pay (Class: 'panel panel-pad') {
            container payH (Class: 'section-label') { dynamictext payHI (Content: 'payments', Class: 'ms') dynamictext payHT (Content: 'Payment') }
            listview lvAttempts (DataSource: DATABASE Shop.PaymentAttempt WHERE [Shop.PaymentAttempt_Order = $TheOrder and (AttemptStatus = 'SUCCEEDED' or AttemptStatus = 'REFUNDED')] SORT BY AttemptNumber ASC, PageSize: 10, Class: 'att-lv') {
              container att {
                dynamictext attM (Content: '{1} · {2}', ContentParams: ({1} = MethodLabel, {2} = AttemptStatus), Class: 'c-green')
                dynamictext attT (Content: 'TxID {1} (simulated) · {2}', ContentParams: ({1} = TransactionId, {2} = FinishedAt format (dateFormat: Custom, customDateFormat: 'yyyy-MM-dd HH:mm')), Class: 't-micro c-muted')
                dynamictext attR (Content: 'Refund {1} · {2}', ContentParams: ({1} = RefundId, {2} = RefundedAt format (dateFormat: Custom, customDateFormat: 'yyyy-MM-dd HH:mm')), Class: 't-micro c-warn', Visible: $currentObject/AttemptStatus = Shop.PaymentAttemptStatus.REFUNDED)
              }
            }
            dynamictext payCancel (Content: '{1} {2}', ContentParams: ({1} = BannerText, {2} = RefundLine), Class: 't-small c-error mt-8', Visible: $currentObject/BannerKind = 'cancelled')
          }
          container addr (Class: 'panel panel-pad') {
            container addrH (Class: 'section-label') { dynamictext addrHI (Content: 'local_shipping', Class: 'ms') dynamictext addrHT (Content: '{1}', ContentParams: ({1} = if $currentObject/IsDelivery then 'Delivered to' else 'Pickup at')) }
            dynamictext addrT (Content: '{1}', ContentParams: ({1} = AddressText), Class: 't-small')
          }
          container hist (Class: 'panel panel-pad') {
            container histH (Class: 'section-label') { dynamictext histHI (Content: 'timeline', Class: 'ms') dynamictext histHT (Content: 'Status history') }
            listview lvHist (DataSource: DATABASE Shop.OrderStatusChange WHERE [Shop.OrderStatusChange_Order = $TheOrder] SORT BY Seq ASC, PageSize: 50, Class: 'hist-lv') {
              container hr (Class: 'hist-row') {
                dynamictext hrT (Content: '{1}', ContentParams: ({1} = ChangedAt format (dateFormat: Custom, customDateFormat: 'HH:mm')), Class: 'ts')
                dynamictext hrS (Content: '● {1}', ContentParams: ({1} = ToStatus), Class: 'badge st-queued')
              }
            }
          }
          container store (Class: 'panel panel-pad t-micro c-muted') {
            dynamictext stT (Content: 'Git Pizza MxDev — Mission Kitchen · 2140 Folsom Street, San Francisco, CA 94110 · (415) 555-0142')
            dynamictext stD (Content: 'Demo receipt of a simulated payment — not a tax invoice. No real payment was made.')
          }
        }
      }
    }
  }
};

/** SCR-40 ERROR 404 // CRUST_NOT_FOUND (US-281). */
create or modify page Shop.NotFound (
  Title: 'Not found — Git Pizza MxDev',
  Layout: Shop.Layout_Minimal,
  Url: 'not-found'
) {
  container page (Class: 'err-page scr-40') {
    container wrap (Class: 'err-wrap') {
      container logo (Class: 'err-logo', OnClick: CALL MICROFLOW Shop.ACT_Nav_Home) { image logoImg (ImageType: imageUrl, ImageUrl: '/assets/brand/logo-horizontal.svg', AlternativeText: 'Git Pizza MxDev logo', Class: 'err-logo-img') }
      container head (Class: 'err-head') {
        image illus (ImageType: imageUrl, ImageUrl: '/assets/illustrations/error-crust-not-found.png', AlternativeText: '', Class: 'err-illus')
        container ht {
          container code (Class: 'err-code') { dynamictext codeI (Content: 'report', Class: 'ms') dynamictext codeT (Content: 'ERROR 404') }
          container title (Class: 'err-title t-h2') { dynamictext titleT (Content: 'CRUST_NOT_FOUND') container titleC (Class: 'cursor amber') { } }
          dynamictext expl (Content: 'The page or record you asked for doesn''t exist. It may have been archived, or the demo was reset.', Class: 't-body-long')
        }
      }
      container trace (Class: 'term') {
        container tBar (Class: 'term-bar') { container tDots (Class: 'dots') { container td1 (Class: 'dot') { } container td2 (Class: 'dot') { } container td3 (Class: 'dot') { } } dynamictext tName (Content: '{1}', ContentParams: ({1} = 'stack_trace.log')) }
        container tBody (Class: 'term-body trace') {
          container tr1 (Class: 'tr') { dynamictext tr1n (Content: '1', Class: 'ln') dynamictext tr1t (Content: '[FATAL] Uncaught ReferenceError: ''crust'' is not defined in scope.', Class: 'c-error') }
          container tr2 (Class: 'tr') { dynamictext tr2n (Content: '2', Class: 'ln') dynamictext tr2t (Content: 'at Kitchen.assemble("/menu/pizzas/pineapple-on-mainframe") // kitchen.ts:102:14') }
          container tr3 (Class: 'tr') { dynamictext tr3n (Content: '3', Class: 'ln') dynamictext tr3t (Content: '{1}', ContentParams: ({1} = 'at Oven.bake({ temp: 850, unit: ''F'' }) // oven.ts:45:22')) }
          container tr4 (Class: 'tr') { dynamictext tr4n (Content: '4', Class: 'ln') dynamictext tr4t (Content: 'at Router.resolve("/menu/pizzas/pineapple-on-mainframe") // router.ts:12:3') }
          container tr5 (Class: 'tr') { dynamictext tr5n (Content: '5', Class: 'ln') dynamictext tr5t (Content: 'at GitPizza.boot() // main.js:1:1') }
        }
      }
      dynamictext resol (Content: '// SUGGESTED RESOLUTION: Re-synchronize with the main branch.', Class: 't-small c-muted')
      container actions (Class: 'row err-actions') {
        container aMain (Class: 'btn btn-primary', OnClick: CALL MICROFLOW Shop.ACT_Nav_Home) { dynamictext aMainI (Content: 'terminal', Class: 'ms md') dynamictext aMainT (Content: 'RETURN_TO_MAIN') }
        container aTrack (Class: 'btn btn-secondary', OnClick: CALL MICROFLOW Shop.ACT_Nav_Track) { dynamictext aTrackI (Content: 'route', Class: 'ms md') dynamictext aTrackT (Content: './track.log') }
      }
      dynamictext status (Content: 'STATUS 404 · demo time', Class: 't-micro c-muted')
    }
  }
};

