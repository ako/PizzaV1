mdl 1;
-- Live updates (BR-ORD-20, US-124, US-287). Mendix has no built-in timer widget
-- in this project and the Marketplace is not reachable from the build, so one
-- small JavaScript action drives refreshes. It holds no business logic: every
-- live page declares a `.gp-poll` container whose On click microflow refreshes
-- that page's data, and the poller only clicks those containers every 2 s. It
-- also detects a lost connection (two failed heartbeats) and toggles the
-- CONNECTION_LOST banner (TXT-NAV-30/31), which is client-side by nature.

/**
 * Starts the page poller once per browser tab (idempotent).
 */
create or modify javascript action Shop."JS_LivePoller" (
  /** Interval in milliseconds between refreshes (≥ 1000). */
  IntervalMs: Integer not null
) returns Boolean
as $$
    if (window.__gpPoller) { return true; }
    var failures = 0, offline = false, busy = false;
    function toast(text, kind) {
        var box = document.querySelector('.toasts');
        if (!box) { return; }
        var t = document.createElement('div');
        t.className = 'toast gp-client-toast' + (kind ? ' ' + kind : '');
        t.setAttribute('role', kind === 'error' ? 'alert' : 'status');
        t.innerHTML = '<span class="ms md" aria-hidden="true"></span><span></span>';
        t.firstChild.textContent = kind === 'error' ? 'error' : kind === 'info' ? 'info' : 'check_circle';
        t.lastChild.textContent = text;
        box.appendChild(t);
        setTimeout(function () { t.remove(); }, kind === 'error' ? 6000 : 4000);
    }
    function userId() {
        try { return String(window.mx && mx.session && mx.session.getUserId ? mx.session.getUserId() : ''); } catch (e) { return ''; }
    }
    function store(key, value) { try { localStorage.setItem(key, value); } catch (e) { /* storage blocked */ } }
    function load(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }
    // US-286 AC3 (TXT-ERR-20): a new guest session after a non-empty cart was lost.
    function trackSession() {
        var uid = userId();
        if (!uid) { return; }
        var badge = document.querySelector('.count-bubble');
        var count = badge ? parseInt(badge.textContent, 10) || 0 : 0;
        var prev = load('gp-session');
        if (prev) {
            var parts = prev.split('|');
            if (parts[0] !== uid && parseInt(parts[1], 10) > 0) {
                toast('Your session expired. Your manifest was cleared.', 'info');
            }
        }
        store('gp-session', uid + '|' + count);
    }
    // US-282 / US-289 AC3: the platform's default error dialog is replaced by SCR-41.
    function showIncident() {
        if (/^\/p\/error/.test(location.pathname)) { return; }
        try { sessionStorage.setItem('gp-failed-url', location.pathname + location.search); } catch (e) { /* storage blocked */ }
        location.assign('/p/error');
    }
    // A new page starts at the top: the layout's scroll container would otherwise keep
    // the previous page's position (e.g. Configure from far down the menu).
    var lastTitle = document.title;
    function resetScrollOnNavigation() {
        if (document.title === lastTitle) { return; }
        lastTitle = document.title;
        window.scrollTo(0, 0);
        document.querySelectorAll('.mx-scrollcontainer-wrapper, .mx-placeholder').forEach(function (el) { el.scrollTop = 0; });
    }
    function watchDialogs() {
        new MutationObserver(function () {
            resetScrollOnNavigation();
            if (offline) {
                // US-287: lost-connection dialogs become the banner plus a toast.
                document.querySelectorAll('.mx-dialog, .modal-dialog').forEach(function (d) {
                    if (d.closest('.gp-app')) { return; }
                    var close = d.querySelector('.close, .mx-dialog-close, button');
                    if (close) { close.click(); }
                });
                return;
            }
            var dlg = document.querySelector('.mx-dialog-error, .modal-dialog.mx-dialog-error, [class*="dialog-error"]');
            if (dlg) { dlg.style.visibility = 'hidden'; showIncident(); }
        }).observe(document.body, { childList: true, subtree: true });
    }
    // US-287 AC3: an action pressed while offline is not sent; the guest is told.
    function guardOffline(e) {
        if (!offline || !e.isTrusted) { return; }
        if (e.type === 'keydown' && e.key !== 'Enter' && e.key !== ' ') { return; }
        var el = e.target && e.target.closest ? e.target.closest('button, a, [role=button], .mx-link, .mx-button, [tabindex]') : null;
        if (!el) { return; }
        e.preventDefault();
        e.stopImmediatePropagation();
        toast('Could not reach the server. Check your connection and try again.', 'error');
    }
    // Focus rings for keyboard users only: the platform focuses the first element on
    // page load, which would otherwise draw a ring the prototype does not have.
    document.addEventListener('keydown', function (e) { if (e.key === 'Tab') { document.documentElement.classList.add('gp-kbd'); } }, true);
    document.addEventListener('mousedown', function () { document.documentElement.classList.remove('gp-kbd'); }, true);
    document.addEventListener('click', guardOffline, true);
    document.addEventListener('keydown', guardOffline, true);
    watchDialogs();
    async function beat() {
        if (busy) { return; }
        busy = true;
        try {
            var ok = true;
            try {
                var r = await fetch('/', { method: 'HEAD', cache: 'no-store' });
                ok = r.ok || r.status < 500;
            } catch (e) { ok = false; }
            if (!ok) {
                failures++;
                if (failures >= 2 && !offline) { offline = true; document.documentElement.classList.add('gp-offline'); }
                return;
            }
            failures = 0;
            if (offline) {
                offline = false;
                document.documentElement.classList.remove('gp-offline');
                toast('Connection restored. Live updates resumed.');
            }
            trackSession();
            if (document.hidden) { return; }
            document.querySelectorAll('.gp-poll').forEach(function (el) { el.click(); });
        } finally { busy = false; }
    }
    window.__gpPoller = setInterval(beat, Math.max(1000, intervalMs));
    return true;
$$;

/**
 * Data source of the header: starts the live poller and returns the guest's cart.
 *
 * @returns The guest's cart
 */
create or modify nanoflow Shop.DS_Shell_Live ()
returns Shop.Cart as $Cart
folder 'Shell'
begin
  $Started = call javascript action Shop.JS_LivePoller(IntervalMs = 2000);
  $Cart = call microflow Shop.DS_Shell_Cart();
  return $Cart;
end;
grant execute on nanoflow Shop.DS_Shell_Live to Shop.Guest; -- auto

/**
 * Shell refresh beat: keeps the header counters current and removes expired
 * toasts (4 s success/info, 6 s warning; errors stay until closed).
 *
 * @param $Cart The guest's cart
 */
create or modify microflow Shop.SUB_Shell_Refresh ($Cart: Shop.Cart)
folder 'Shell'
begin
  retrieve $Expired from Shop.Toast where [Shop.Toast_Owner = '[%CurrentUser%]' and ExpiresAt < '[%CurrentDateTime%]'];
  delete $Expired refresh;
  retrieve $Fresh from Shop.Cart where [Shop.Cart_Owner = '[%CurrentUser%]'] first;
  if $Fresh != empty then
    commit $Fresh without events refresh;
  end if;
end;

/**
 * Shell refresh beat: keeps the header counters current and removes expired
 * toasts (4 s success/info, 6 s warning; errors stay until closed).
 * Page entry point; the logic is in SUB_Shell_Refresh.
 *
 * @param $Cart The guest's cart
 */
create or modify microflow Shop.ACT_Shell_Refresh ($Cart: Shop.Cart)
folder 'Shell'
begin
  call microflow Shop.SUB_Shell_Refresh(Cart = $Cart);
end;
grant execute on microflow Shop.ACT_Shell_Refresh to Shop.Guest; -- auto
