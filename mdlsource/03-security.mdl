mdl 1;
-- Security (information model section 10): production level, one guest role.
-- Every visitor is an anonymous user with user role Anonymous (LITE-SES-01).
-- Entity access is the server-side boundary (LITE-SEC-01); microflows run
-- without entity access and re-check every guard themselves.

create or modify module role Shop.Guest description 'Every visitor: an anonymous guest';

-- ── Catalog: published menu only
-- public reference data (the allergen notice lists them all); accepted SEC007, see FINDINGS.md
grant read * on entity Catalog.Allergen to Catalog.Guest;
grant read * on entity Catalog.Category to Catalog.Guest where [Catalog.Product_Category/Catalog.Product/ProductStatus = 'PUBLISHED'];
grant read * on entity Catalog.Product to Catalog.Guest where [ProductStatus = 'PUBLISHED'];
grant read * on entity Catalog.ProductSize to Catalog.Guest where [Catalog.ProductSize_Product/Catalog.Product/ProductStatus = 'PUBLISHED'];
grant read * on entity Catalog.RecipeItem to Catalog.Guest where [Catalog.RecipeItem_Product/Catalog.Product/ProductStatus = 'PUBLISHED'];
grant read * on entity Catalog.Ingredient to Catalog.Guest where [Catalog.RecipeItem_Ingredient/Catalog.RecipeItem/Catalog.RecipeItem_Product/Catalog.Product/ProductStatus = 'PUBLISHED' or Catalog.Option_Ingredient/Catalog.Option/IsActive = true];
grant read * on entity Catalog.Option to Catalog.Guest where [IsActive = true];
-- only the zone of the guest's own checkout or orders (the zone table itself is checked server-side)
grant read * on entity Shop.DeliveryZone to Shop.Guest where [Shop.CheckoutForm_Zone/Shop.CheckoutForm/Shop.CheckoutForm_Owner = '[%CurrentUser%]' or Shop.Order_Zone/Shop.Order/Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
grant read (StoreName, AddressLine, Phone, TaxRatePercent, DeliveryFee, FreeDeliveryThreshold, MinDeliverySubtotal, MaxQuantityPerLine, MaxItemsPerOrder, MaxPaymentAttempts) on entity Shop.StoreSettings to Shop.Guest;

-- ── The guest's own session state
grant read *, write (CouponInput, SearchInput, SearchQuery) on entity Shop.Cart to Shop.Guest where [Shop.Cart_Owner = '[%CurrentUser%]'];
grant read * on entity Shop.CartLine to Shop.Guest where [Shop.CartLine_Cart/Shop.Cart/Shop.Cart_Owner = '[%CurrentUser%]'];
grant read *, write (AddressLine1, AddressLine2, City, StateCode, Zip, DeliveryNotes, ContactName, ContactEmail, ContactPhone) on entity Shop.CheckoutForm to Shop.Guest where [Shop.CheckoutForm_Owner = '[%CurrentUser%]'];
grant read * on entity Shop.Toast to Shop.Guest where [Shop.Toast_Owner = '[%CurrentUser%]'];
grant read * on entity Shop.Coupon to Shop.Guest where [Shop.Cart_Coupon/Shop.Cart/Shop.Cart_Owner = '[%CurrentUser%]'];
grant read * on entity Shop.PriceResult to Shop.Guest;
grant read * on entity Shop.HomeView to Shop.Guest;
grant read * on entity Shop.MenuView to Shop.Guest;
grant read * on entity Shop.Choice to Shop.Guest;
grant read * on entity Shop.TrackView to Shop.Guest;
grant read *, write (OrderNumber, Email) on entity Shop.LookupForm to Shop.Guest;

-- ── Orders the guest holds a token for (LITE-SES-03): placed, looked up or opened by tracking link
grant read * on entity Shop.OrderAccess to Shop.Guest where [Shop.OrderAccess_User = '[%CurrentUser%]'];
grant read * on entity Shop.Order to Shop.Guest where [Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
grant read * on entity Shop.OrderLine to Shop.Guest where [Shop.OrderLine_Order/Shop.Order/Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
grant read * on entity Shop.OrderLineModifier to Shop.Guest where [Shop.OrderLineModifier_OrderLine/Shop.OrderLine/Shop.OrderLine_Order/Shop.Order/Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
grant read (AttemptNumber, Method, Card, Amount, AttemptStatus, FailureCode, TransactionId, StartedAt, FinishedAt, RefundedAt, RefundId, MethodLabel, PaymentAttempt_Order) on entity Shop.PaymentAttempt to Shop.Guest where [Shop.PaymentAttempt_Order/Shop.Order/Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
-- status history: time and status only
grant read (ToStatus, ChangedAt, Seq, OrderStatusChange_Order) on entity Shop.OrderStatusChange to Shop.Guest where [Shop.OrderStatusChange_Order/Shop.Order/Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
-- customer-visible log lines only
grant read (LoggedAt, TimeText, Level, Tag, Message, Seq, IsCustomerVisible, OrderLogEntry_Order) on entity Shop.OrderLogEntry to Shop.Guest where [IsCustomerVisible = true and Shop.OrderLogEntry_Order/Shop.Order/Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
-- courier and oven of a token order: display fields only
grant read (Name, NodeHandle, Vehicle) on entity Shop.Courier to Shop.Guest where [Shop.Order_Courier/Shop.Order/Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
grant read (Code, DisplayName) on entity Shop.Oven to Shop.Guest where [Shop.Order_Oven/Shop.Order/Shop.OrderAccess_Order/Shop.OrderAccess/Shop.OrderAccess_User = '[%CurrentUser%]'];
