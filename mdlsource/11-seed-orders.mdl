begin
  $token = call microflow Shop.SUB_RandomHex(Length = 32);
  $o = create Shop.Order (OrderNumber = 1031, CommitHash = 'fc5fdf0', TrackingToken = $token, Source = Shop.OrderSource.SIMULATOR, OrderType = Shop.OrderType.DELIVERY, OrderStatus = Shop.OrderStatus.OUT_FOR_DELIVERY, StatusChangedAt = addSeconds($T, -70), Payment = Shop.PaymentStatus.PAID, ContactName = 'Luis Hernández', ContactEmail = 'luis.hernandez@example.net', ContactPhone = '(415) 555-0134', AddressLine1 = '958 Valencia Street', AddressLine2 = 'Apt 3', City = 'San Francisco', StateCode = 'CA', Zip = '94110', DeliveryNotes = '', DistanceMiles = 0.8, CouponCode = '', Subtotal = 21.24, DiscountAmount = 0.0, DeliveryFee = 3.99, FeeWaivedBy = empty, TaxRatePercent = 8.625, TaxAmount = 1.83, Tip = Shop.TipOption.TEN, TipAmount = 2.12, Total = 29.18, PlacedAt = addSeconds($T, -251), PaidAt = addSeconds($T, -248), QueuedAt = addSeconds($T, -248), BakingStartedAt = addSeconds($T, -226), QaStartedAt = addSeconds($T, -135), ReadyAt = addSeconds($T, -105), DispatchedAt = addSeconds($T, -70), CompletedAt = empty, CancelledAt = empty, RouteProgressPercent = 76, TimerProgress = 0.76, TimerAnchorAt = $T, IsQaSlicedDone = true, IsQaExtrasDone = true, IsQaSealedDone = true, RemakeCount = 0, IsPriority = false, CancelReason = '', CancelledBy = empty, PizzaCount = 1, ItemCount = 2, IsOpen = true);
