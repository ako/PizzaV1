/**
 * Seed order MX-1028 (SIMULATOR, DELIVERY, DELIVERED).
 * FREE_DISPATCH coupon waives the delivery fee
 *
 * @param $T Demo start time: relative seed timestamps resolve against it
 */
create or modify microflow Simulation.SEED_Order_1028 ($T: DateTime)
folder 'Seed/Orders'
begin
  $token = call microflow Shop.SUB_RandomHex(Length = 32);
  $o = create Shop.Order (OrderNumber = 1028, CommitHash = '5072ebb', TrackingToken = $token, Source = Shop.OrderSource.SIMULATOR, OrderType = Shop.OrderType.DELIVERY, OrderStatus = Shop.OrderStatus.DELIVERED, StatusChangedAt = addSeconds($T, -627), Payment = Shop.PaymentStatus.PAID, ContactName = 'Ryan O''Connor', ContactEmail = 'ryan.oconnor@example.com', ContactPhone = '(415) 555-0131', AddressLine1 = '201 Spear Street', AddressLine2 = 'Floor 11', City = 'San Francisco', StateCode = 'CA', Zip = '94105', DeliveryNotes = 'Reception desk on the 11th floor.', DistanceMiles = 2.8, CouponCode = 'FREE_DISPATCH', Subtotal = 23.49, DiscountAmount = 0.0, DeliveryFee = 0.0, FeeWaivedBy = Shop.FeeWaiver.COUPON, TaxRatePercent = 8.625, TaxAmount = 2.03, Tip = Shop.TipOption.FIFTEEN, TipAmount = 3.52, Total = 29.04, PlacedAt = addSeconds($T, -980), PaidAt = addSeconds($T, -977), QueuedAt = addSeconds($T, -977), BakingStartedAt = addSeconds($T, -956), QaStartedAt = addSeconds($T, -865), ReadyAt = addSeconds($T, -834), DispatchedAt = addSeconds($T, -799), CompletedAt = addSeconds($T, -627), CancelledAt = empty, RouteProgressPercent = 100, TimerProgress = 0, TimerAnchorAt = $T, IsQaSlicedDone = true, IsQaExtrasDone = true, IsQaSealedDone = true, RemakeCount = 0, IsPriority = false, CancelReason = '', CancelledBy = empty, PizzaCount = 1, ItemCount = 2, IsOpen = false);
  retrieve $zone from Shop.DeliveryZone where Zip = '94105' first;
  change $o (Shop.Order_Zone = $zone);
  retrieve $coupon from Shop.Coupon where Code = 'FREE_DISPATCH' first;
  change $o (Shop.Order_Coupon = $coupon);
  retrieve $oven from Shop.Oven where Code = 'OVEN_01' first;
  change $o (Shop.Order_Oven = $oven);
  retrieve $courier from Shop.Courier where Code = 'CU-02' first;
  change $o (Shop.Order_Courier = $courier) commit without events;
  call microflow Simulation.SEED_Order_1028_Lines(TheOrder = $o);
  call microflow Simulation.SEED_Order_1028_History(TheOrder = $o, T = $T);
  call microflow Simulation.SEED_Order_1028_Log(TheOrder = $o, T = $T);
  call microflow Shop.SUB_Order_RefreshPaymentLabel(TheOrder = $o);
end;

