  change $o (Shop.Order_Oven = $oven);
  retrieve $courier from Shop.Courier where Code = 'CU-03' first;
  change $o (Shop.Order_Courier = $courier) commit without events;
  retrieve $cur from Shop.Courier where Code = 'CU-03' first;
  change $cur (Shop.Courier_CurrentOrder = $o) commit without events;
  call microflow Simulation.SEED_Order_1031_Lines(TheOrder = $o);
  call microflow Simulation.SEED_Order_1031_History(TheOrder = $o, T = $T);
