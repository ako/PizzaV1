 *
 * @param $T Demo start time: relative seed timestamps resolve against it
 */
create or modify microflow Simulation.SEED_Order_1019 ($T: DateTime)
folder 'Seed/Orders'
begin
  $token = call microflow Shop.SUB_RandomHex(Length = 32);
  $o = create Shop.Order (OrderNumber = 1019, CommitHash = '974bc9c', TrackingToken = $token, Source = Shop.OrderSource.GUEST, OrderType = Shop.OrderType.DELIVERY, OrderStatus = Shop.OrderStatus.DELIVERED, StatusChangedAt = addSeconds($T, -6428), Payment = Shop.PaymentStatus.PAID, ContactName = 'Marcus Johnson', ContactEmail = 'marcus.johnson@example.com', ContactPhone = '(415) 555-0121', AddressLine1 = '1025 Folsom Street', AddressLine2 = 'Unit 612', City = 'San Francisco', StateCode = 'CA', Zip = '94103', DeliveryNotes = 'Code 0612 at the gate.', DistanceMiles = 1.4, CouponCode = '', Subtotal = 32.49, DiscountAmount = 0.0, DeliveryFee = 3.99, FeeWaivedBy = empty, TaxRatePercent = 8.625, TaxAmount = 2.8, Tip = Shop.TipOption.FIFTEEN, TipAmount = 4.87, Total = 44.15, PlacedAt = addSeconds($T, -6730), PaidAt = addSeconds($T, -6727), QueuedAt = addSeconds($T, -6727), BakingStartedAt = addSeconds($T, -6701), QaStartedAt = addSeconds($T, -6610), ReadyAt = addSeconds($T, -6579), DispatchedAt = addSeconds($T, -6544), CompletedAt = addSeconds($T, -6428), CancelledAt = empty, RouteProgressPercent = 100, TimerProgress = 0, TimerAnchorAt = $T, IsQaSlicedDone = true, IsQaExtrasDone = true, IsQaSealedDone = true, RemakeCount = 0, IsPriority = false, CancelReason = '', CancelledBy = empty, PizzaCount = 1, ItemCount = 4, IsOpen = false);
  retrieve $zone from Shop.DeliveryZone where Zip = '94103' first;
  change $o (Shop.Order_Zone = $zone);
  retrieve $oven from Shop.Oven where Code = 'OVEN_01' first;
  change $o (Shop.Order_Oven = $oven);
  retrieve $courier from Shop.Courier where Code = 'CU-01' first;
  change $o (Shop.Order_Courier = $courier) commit without events;
  call microflow Simulation.SEED_Order_1019_Lines(TheOrder = $o);
  call microflow Simulation.SEED_Order_1019_History(TheOrder = $o, T = $T);
  call microflow Simulation.SEED_Order_1019_Log(TheOrder = $o, T = $T);
  call microflow Shop.SUB_Order_RefreshPaymentLabel(TheOrder = $o);
end;

