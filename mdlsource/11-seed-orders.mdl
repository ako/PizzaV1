folder 'Seed/Orders'
begin
  $token = call microflow Shop.SUB_RandomHex(Length = 32);
  $o = create Shop.Order (OrderNumber = 1024, CommitHash = '3f00677', TrackingToken = $token, Source = Shop.OrderSource.GUEST, OrderType = Shop.OrderType.PICKUP, OrderStatus = Shop.OrderStatus.PICKED_UP, StatusChangedAt = addSeconds($T, -2954), Payment = Shop.PaymentStatus.PAID, ContactName = 'Aisha Patel', ContactEmail = 'aisha.patel@example.com', ContactPhone = '(415) 555-0127', AddressLine1 = '', AddressLine2 = '', City = '', StateCode = '', Zip = '', DeliveryNotes = '', DistanceMiles = 0, CouponCode = 'GITHUB_STUDENT', Subtotal = 29.19, DiscountAmount = 4.38, DeliveryFee = 0.0, FeeWaivedBy = empty, TaxRatePercent = 8.625, TaxAmount = 2.14, Tip = Shop.TipOption.NONE, TipAmount = 0.0, Total = 26.95, PlacedAt = addSeconds($T, -3165), PaidAt = addSeconds($T, -3162), QueuedAt = addSeconds($T, -3162), BakingStartedAt = addSeconds($T, -3139), QaStartedAt = addSeconds($T, -3048), ReadyAt = addSeconds($T, -3018), DispatchedAt = empty, CompletedAt = addSeconds($T, -2954), CancelledAt = empty, RouteProgressPercent = 0, TimerProgress = 0, TimerAnchorAt = $T, IsQaSlicedDone = true, IsQaExtrasDone = true, IsQaSealedDone = true, RemakeCount = 0, IsPriority = false, CancelReason = '', CancelledBy = empty, PizzaCount = 1, ItemCount = 3, IsOpen = false);
