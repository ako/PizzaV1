mdl 1;
-- Order processes: T-01 creation with snapshots, SIM-01 payment outcome (T-02..T-05),
-- cancellation (T-04, T-06, T-07, T-09) and refund (BR-ORD-10).

/**
 * Seconds-based progress p of a simulator timer (BR-ORD-21):
 * p = stored progress + elapsed since anchor / eff(base).
 *
 * @param $Progress Progress at the anchor (0–1)
 * @param $AnchorAt Moment the progress was last anchored
 * @param $BaseSeconds Timer duration at 1×
 * @returns Current progress (may exceed 1)
 */
create or modify microflow Fulfilment.SUB_Timer_Progress ($Progress: Decimal, $AnchorAt: DateTime, $BaseSeconds: Integer)
returns Decimal as $P
folder 'Simulation'
begin
  $Eff = call microflow Core.SUB_Eff(Base = $BaseSeconds);
  declare $Elapsed Decimal = 0;
  if $AnchorAt != empty then
    if $AnchorAt < [%CurrentDateTime%] then
      set $Elapsed = secondsBetween($AnchorAt, [%CurrentDateTime%]);
    end if;
  end if;
  declare $P Decimal = $Progress + $Elapsed div $Eff;
  return $P;
end;

/**
 * Base duration (at 1×) of the automatic timer that runs in the order's
 * current state (order-lifecycle 7.1); 0 when no timer runs.
 *
 * @param $TheOrder The order
 * @returns Seconds at 1×
 */
create or modify microflow Fulfilment.SUB_Order_TimerBase ($TheOrder: Fulfilment.Order)
returns Integer as $Base
folder 'Simulation'
begin
  retrieve $Sim from Core.SimulationSettings first;
  declare $Base Integer = 0;
  declare $Status Enumeration(Fulfilment.OrderStatus) = $TheOrder/OrderStatus;
  if $Status = Fulfilment.OrderStatus.PAYMENT_PENDING then
    retrieve $Attempt from Fulfilment.PaymentAttempt where [Fulfilment.PaymentAttempt_Order = $TheOrder and AttemptStatus = 'PROCESSING'] sort by AttemptNumber desc first;
    set $Base = $Sim/PaymentProcessing;
    if $Attempt != empty then
      if $Attempt/Card = Fulfilment.TestCard.AMEX_0005 then
        set $Base = $Sim/PaymentTimeout;
      end if;
    end if;
  end if;
  if $Status = Fulfilment.OrderStatus.PAYMENT_FAILED then
    if $TheOrder/Source = Fulfilment.OrderSource.SIMULATOR then
      set $Base = $Sim/SimulatedRetryDelay;
    else
      set $Base = $Sim/PaymentFailedTimeout;
    end if;
  end if;
  if $Status = Fulfilment.OrderStatus.QUEUED then
    set $Base = $Sim/QueueWait;
  end if;
  if $Status = Fulfilment.OrderStatus.BAKING then
    set $Base = $Sim/Bake;
  end if;
  if $Status = Fulfilment.OrderStatus.QA_CHECK then
    set $Base = $Sim/Qa;
  end if;
  if $Status = Fulfilment.OrderStatus.READY_FOR_PICKUP then
    set $Base = $Sim/PickupArrival;
  end if;
  if $Status = Fulfilment.OrderStatus.OUT_FOR_DELIVERY then
    set $Base = round($Sim/TravelBase + $Sim/TravelPerMile * $TheOrder/DistanceMiles);
  end if;
  return $Base;
end;

/**
 * Current progress p of the order's running timer.
 *
 * @param $TheOrder The order
 * @returns Progress (0 when no timer runs)
 */
create or modify microflow Fulfilment.SUB_Order_Progress ($TheOrder: Fulfilment.Order)
returns Decimal as $P
folder 'Simulation'
begin
  $Base = call microflow Fulfilment.SUB_Order_TimerBase(TheOrder = $TheOrder);
  if $Base <= 0 then
    return 0;
  end if;
  $P = call microflow Fulfilment.SUB_Timer_Progress(Progress = $TheOrder/TimerProgress, AnchorAt = $TheOrder/TimerAnchorAt, BaseSeconds = $Base);
  return $P;
end;

/**
 * T-01: turns prepared order data and configured lines into an order in
 * PAYMENT_PENDING (BR-ORD-03 is checked by the caller). Assigns number,
 * commit hash and tracking token, snapshots the lines and modifiers
 * (BR-DATA-03), fixes every amount (BR-PRICE-12), stores the coupon only
 * when APPLIED (BR-PRICE-06), creates payment attempt #1 in PROCESSING and
 * writes the T-01 log lines.
 *
 * @param $TheOrder Order holding type, contact, address, tip and source (not yet numbered)
 * @param $Lines The configured lines to snapshot
 * @param $Coupon Coupon of the cart (may be empty)
 * @param $Method Payment method
 * @param $Card Test card (CARD only)
 * @param $Actor Actor type of the creation
 * @param $ActorName guest or sim/traffic
 */
create or modify microflow Shop.SUB_Order_Place ($TheOrder: Fulfilment.Order, $Lines: List of Shop.CartLine, $Coupon: Fulfilment.Coupon, $Method: Enumeration(Fulfilment.PaymentMethod), $Card: Enumeration(Fulfilment.TestCard), $Actor: Enumeration(Fulfilment.ActorType), $ActorName: String)
folder 'Orders'
begin
  retrieve $Store from Core.StoreSettings first;
  declare $Number Integer = $Store/NextOrderNumber;
  change $Store (NextOrderNumber = $Number + 1) commit without events;
  $Hash = call microflow Core.SUB_RandomHex(Length = 7);
  $Token = call microflow Core.SUB_RandomHex(Length = 32);
  declare $Now DateTime = [%CurrentDateTime%];
  -- snapshot lines
  declare $Subtotal Decimal = 0;
  declare $Items Integer = 0;
  declare $Pizzas Integer = 0;
  declare $Sort Integer = 0;
  loop $Line in $Lines
  begin
    retrieve $Product from $Line/Shop.CartLine_Product;
    retrieve $Size from $Line/Shop.CartLine_Size;
    retrieve $LineAllergens from $Line/Shop.CartLine_Allergen;
    $AllergenText = call microflow Catalog.SUB_AllergenText(Allergens = $LineAllergens);
    set $Sort = $Sort + 1;
    declare $SizeLabel String = getCaption($Size/Size);
    if $Product/Kind != Catalog.ProductKind.PIZZA then
      set $SizeLabel = $Size/ServingDescription;
    end if;
    $OLine = create Fulfilment.OrderLine (ProductCode = $Product/Code, ProductName = $Product/Name, RealWorldName = $Product/RealWorldName, ModuleKey = $Product/ModuleKey,
      Kind = $Product/Kind, Size = $Size/Size, SizeLabel = $SizeLabel, Quantity = $Line/Quantity, UnitPrice = $Line/UnitPrice, LineTotal = $Line/LineTotal,
      AllergenText = $AllergenText, IsVegetarian = $Line/IsVegetarian, IsVegan = $Line/IsVegan, ConfigText = $Line/ConfigText, SortOrder = $Sort,
      Fulfilment.OrderLine_Order = $TheOrder, Fulfilment.OrderLine_Product = $Product) commit without events;
    set $Subtotal = $Subtotal + $Line/LineTotal;
    set $Items = $Items + $Line/Quantity;
    if $Product/Kind = Catalog.ProductKind.PIZZA then
      set $Pizzas = $Pizzas + $Line/Quantity;
      call microflow Shop.SUB_OrderLine_SnapshotModifiers(OLine = $OLine, Line = $Line);
    end if;
  end loop;
  $Price = call microflow Fulfilment.SUB_Price_Compute(Subtotal = $Subtotal, OrderType = $TheOrder/OrderType, Coupon = $Coupon, Tip = $TheOrder/Tip);
  retrieve $Zone from $TheOrder/Fulfilment.Order_Zone;
  declare $Distance Decimal = 0;
  if $Zone != empty then
    set $Distance = $Zone/DistanceMiles;
  end if;
  change $TheOrder (OrderNumber = $Number, CommitHash = $Hash, TrackingToken = $Token, Payment = Fulfilment.PaymentStatus.UNPAID, PlacedAt = $Now,
    Subtotal = $Subtotal, DiscountAmount = $Price/Discount, DeliveryFee = $Price/DeliveryFee, FeeWaivedBy = $Price/FeeWaivedBy,
    TaxRatePercent = $Store/TaxRatePercent, TaxAmount = $Price/Tax, TipAmount = $Price/TipAmount, Total = $Price/Total,
    ItemCount = $Items, PizzaCount = $Pizzas, DistanceMiles = $Distance, IsOpen = true, TimerProgress = 0, TimerAnchorAt = $Now);
  if $Price/CouponState = Fulfilment.CouponState.APPLIED then
    change $TheOrder (Fulfilment.Order_Coupon = $Coupon, CouponCode = $Coupon/Code);
  end if;
  commit $TheOrder without events;
  $Attempt = create Fulfilment.PaymentAttempt (AttemptNumber = 1, Method = $Method, Card = $Card, Amount = $Price/Total, AttemptStatus = Fulfilment.PaymentAttemptStatus.PROCESSING, StartedAt = $Now, Fulfilment.PaymentAttempt_Order = $TheOrder) commit without events;
  call microflow Fulfilment.SUB_Order_Transition(TheOrder = $TheOrder, ToStatus = Fulfilment.OrderStatus.PAYMENT_PENDING, Actor = $Actor, ActorName = $ActorName, Reason = '');
  call microflow Fulfilment.SUB_Order_Log(TheOrder = $TheOrder, Level = Fulfilment.LogLevel.INFO, Tag = 'INIT', Message = 'Order MX-' + toString($Number) + ' staged. Commit #' + $Hash + ' signed.', Visible = true);
  call microflow Fulfilment.SUB_Order_Log(TheOrder = $TheOrder, Level = Fulfilment.LogLevel.INFO, Tag = 'PAYMENT', Message = 'Handshake with payment gateway (simulated)…', Visible = true);
  call microflow Fulfilment.SUB_Order_RefreshPaymentLabel(TheOrder = $TheOrder);
end;

/**
 * Snapshots the configuration of a pizza line as modifiers: exactly one
 * CRUST, SAUCE and CHEESE (default marked, surcharge 0 when default), then
 * one ADD per extra and one REMOVE per removed ingredient.
 *
 * @param $OLine The order line
 * @param $Line The configured cart line
 */
create or modify microflow Shop.SUB_OrderLine_SnapshotModifiers ($OLine: Fulfilment.OrderLine, $Line: Shop.CartLine)
folder 'Orders'
begin
  retrieve $Product from $Line/Shop.CartLine_Product;
  retrieve $Size from $Line/Shop.CartLine_Size;
  retrieve $DefCrust from $Product/Catalog.Product_DefaultCrust;
  retrieve $DefSauce from $Product/Catalog.Product_DefaultSauce;
  retrieve $DefCheese from $Product/Catalog.Product_DefaultCheese;
  retrieve $Crust from $Line/Shop.CartLine_Crust;
  retrieve $Sauce from $Line/Shop.CartLine_Sauce;
  retrieve $Cheese from $Line/Shop.CartLine_Cheese;
  $MCrust = create Fulfilment.OrderLineModifier (ModifierType = Fulfilment.ModifierType.CRUST, OptionKey = $Crust/OptionKey, Name = $Crust/Name, Price = if $Crust = $DefCrust then 0 else $Crust/Surcharge, IsDefault = $Crust = $DefCrust, SortOrder = 1, Fulfilment.OrderLineModifier_OrderLine = $OLine);
  $MSauce = create Fulfilment.OrderLineModifier (ModifierType = Fulfilment.ModifierType.SAUCE, OptionKey = $Sauce/OptionKey, Name = $Sauce/Name, Price = if $Sauce = $DefSauce then 0 else $Sauce/Surcharge, IsDefault = $Sauce = $DefSauce, SortOrder = 2, Fulfilment.OrderLineModifier_OrderLine = $OLine);
  $MCheese = create Fulfilment.OrderLineModifier (ModifierType = Fulfilment.ModifierType.CHEESE, OptionKey = $Cheese/OptionKey, Name = $Cheese/Name, Price = if $Cheese = $DefCheese then 0 else $Cheese/Surcharge, IsDefault = $Cheese = $DefCheese, SortOrder = 3, Fulfilment.OrderLineModifier_OrderLine = $OLine);
  $Mods = create list of Fulfilment.OrderLineModifier;
  add $MCrust to $Mods;
  add $MSauce to $Mods;
  add $MCheese to $Mods;
  retrieve $Extras from $Line/Shop.CartLine_Extra;
  $SortedExtras = sort $Extras by SortOrder asc;
  declare $Sort Integer = 3;
  loop $Extra in $SortedExtras
  begin
    $ExtraPrice = call microflow Catalog.SUB_Option_PriceFor(Option = $Extra, Size = $Size/Size);
    set $Sort = $Sort + 1;
    $MAdd = create Fulfilment.OrderLineModifier (ModifierType = Fulfilment.ModifierType.ADD, OptionKey = $Extra/OptionKey, Name = $Extra/Name, Price = $ExtraPrice, IsDefault = false, SortOrder = $Sort, Fulfilment.OrderLineModifier_OrderLine = $OLine);
    add $MAdd to $Mods;
  end loop;
  retrieve $Removed from $Line/Shop.CartLine_Removed;
  loop $Ing in $Removed
  begin
    set $Sort = $Sort + 1;
    $MRemove = create Fulfilment.OrderLineModifier (ModifierType = Fulfilment.ModifierType.REMOVE, OptionKey = $Ing/Code, Name = $Ing/Name, Price = 0, IsDefault = false, SortOrder = $Sort, Fulfilment.OrderLineModifier_OrderLine = $OLine);
    add $MRemove to $Mods;
  end loop;
  commit $Mods without events;
end;

/**
 * Decides the processing payment attempt of an order (SIM-01, BR-ORD-04):
 * the test card decides; Apple Pay, Google Pay, 4242 and 4444 succeed
 * (random failure rate is 0 % in Lite). Performs T-02, T-03 or T-04.
 *
 * @param $TheOrder An order in PAYMENT_PENDING whose timer is due
 */
create or modify microflow Shop.SUB_Payment_Resolve ($TheOrder: Fulfilment.Order)
folder 'Orders'
begin
  retrieve $Attempt from Fulfilment.PaymentAttempt where [Fulfilment.PaymentAttempt_Order = $TheOrder and AttemptStatus = 'PROCESSING'] sort by AttemptNumber desc first;
  if $Attempt = empty then
    return;
  end if;
  declare $Now DateTime = [%CurrentDateTime%];
  declare $Code Enumeration(Fulfilment.PaymentFailureCode) = empty;
  if $Attempt/Method = Fulfilment.PaymentMethod.CARD then
    if $Attempt/Card = Fulfilment.TestCard.VISA_0002 or $Attempt/Card = empty then
      set $Code = Fulfilment.PaymentFailureCode.DECLINED;
    end if;
    if $Attempt/Card = Fulfilment.TestCard.VISA_9995 then
      set $Code = Fulfilment.PaymentFailureCode.INSUFFICIENT_FUNDS;
    end if;
    if $Attempt/Card = Fulfilment.TestCard.AMEX_0005 then
      set $Code = Fulfilment.PaymentFailureCode.GATEWAY_TIMEOUT;
    end if;
  end if;
  declare $Number String = 'MX-' + toString($TheOrder/OrderNumber);
  if $Code = empty then
    $Hex = call microflow Core.SUB_RandomHex(Length = 12);
    change $Attempt (AttemptStatus = Fulfilment.PaymentAttemptStatus.SUCCEEDED, TransactionId = 'txn_sim_' + $Hex, FinishedAt = $Now) commit without events;
    change $TheOrder (Payment = Fulfilment.PaymentStatus.PAID, PaidAt = $Now, QueuedAt = $Now);
    call microflow Fulfilment.SUB_Order_Transition(TheOrder = $TheOrder, ToStatus = Fulfilment.OrderStatus.QUEUED, Actor = Fulfilment.ActorType.SIMULATOR, ActorName = 'sim/payment-gateway', Reason = '');
    retrieve $Queued from Fulfilment.Order where [OrderStatus = 'QUEUED'];
    $Position = count $Queued;
    call microflow Fulfilment.SUB_Order_Log(TheOrder = $TheOrder, Level = Fulfilment.LogLevel.SUCCESS, Tag = 'PAYMENT', Message = 'Payment confirmed. TxID txn_sim_' + $Hex, Visible = true);
    call microflow Fulfilment.SUB_Order_Log(TheOrder = $TheOrder, Level = Fulfilment.LogLevel.INFO, Tag = 'KITCHEN', Message = 'Order queued at position ' + toString($Position) + '.', Visible = true);
    $OkEvent = create Fulfilment.SimulationEvent (OccurredAt = $Now, EventType = Fulfilment.SimulationEventType.PAYMENT_RESULT, Message = $Number + ' payment attempt ' + toString($Attempt/AttemptNumber) + ': SUCCEEDED', Fulfilment.SimulationEvent_Order = $TheOrder) commit without events;
    -- T-02 side effect: clear the guest's cart and coupon (BR-ORD-07)
    retrieve $Placer from $TheOrder/Fulfilment.Order_PlacedBy;
    if $Placer != empty then
      retrieve $Cart from Shop.Cart where [Shop.Cart_Owner = $Placer] first;
      if $Cart != empty then
        retrieve $CartLines from Shop.CartLine where [Shop.CartLine_Cart = $Cart and IsDraft = false];
        delete $CartLines;
        change $Cart (Shop.Cart_Coupon = empty, CouponInput = '', CouponFieldError = '');
        call microflow Shop.SUB_Cart_Recalculate(Cart = $Cart);
      end if;
    end if;
    return;
  end if;
  change $Attempt (AttemptStatus = Fulfilment.PaymentAttemptStatus.FAILED, FailureCode = $Code, FinishedAt = $Now) commit without events;
  declare $Text String = getCaption($Code);
  $FailEvent = create Fulfilment.SimulationEvent (OccurredAt = $Now, EventType = Fulfilment.SimulationEventType.PAYMENT_RESULT, Message = $Number + ' payment attempt ' + toString($Attempt/AttemptNumber) + ': FAILED (' + getKey($Code) + ')', Fulfilment.SimulationEvent_Order = $TheOrder) commit without events;
  retrieve $Store from Core.StoreSettings first;
  call microflow Fulfilment.SUB_Order_Log(TheOrder = $TheOrder, Level = Fulfilment.LogLevel.ERROR, Tag = 'PAYMENT', Message = 'ERROR 402: ' + $Text + '. Attempt ' + toString($Attempt/AttemptNumber) + ' of 3.', Visible = true);
  if $Attempt/AttemptNumber >= $Store/MaxPaymentAttempts then
    change $TheOrder (CancelledAt = $Now, CancelledBy = Fulfilment.ActorType.SYSTEM, CancelReason = 'Payment failed 3 times');
    call microflow Fulfilment.SUB_Order_Transition(TheOrder = $TheOrder, ToStatus = Fulfilment.OrderStatus.CANCELLED, Actor = Fulfilment.ActorType.SYSTEM, ActorName = 'sys/payment-attempts', Reason = 'Payment failed 3 times');
    call microflow Fulfilment.SUB_Order_Log(TheOrder = $TheOrder, Level = Fulfilment.LogLevel.ERROR, Tag = 'ROLLBACK', Message = 'Order rolled back: payment failed 3 times.', Visible = true);
  else
    call microflow Fulfilment.SUB_Order_Transition(TheOrder = $TheOrder, ToStatus = Fulfilment.OrderStatus.PAYMENT_FAILED, Actor = Fulfilment.ActorType.SIMULATOR, ActorName = 'sim/payment-gateway', Reason = '');
  end if;
end;

/**
 * T-05: retries the payment of an order in PAYMENT_FAILED with a (possibly
 * different) method and card. Same order, same total (BR-PRICE-12).
 *
 * @param $TheOrder The order
 * @param $Method Payment method
 * @param $Card Test card (CARD only)
 * @param $Actor Actor type
 * @param $ActorName guest or sim/customer
 * @returns True when a new attempt was created
 */
create or modify microflow Fulfilment.SUB_Payment_Retry ($TheOrder: Fulfilment.Order, $Method: Enumeration(Fulfilment.PaymentMethod), $Card: Enumeration(Fulfilment.TestCard), $Actor: Enumeration(Fulfilment.ActorType), $ActorName: String)
returns Boolean as $Ok
folder 'Orders'
begin
  if $TheOrder/OrderStatus != Fulfilment.OrderStatus.PAYMENT_FAILED then
    return false;
  end if;
  retrieve $Attempts from Fulfilment.PaymentAttempt where [Fulfilment.PaymentAttempt_Order = $TheOrder];
  $Count = count $Attempts;
  if $Count >= 3 then
    return false;
  end if;
  declare $Next Integer = $Count + 1;
  $Attempt = create Fulfilment.PaymentAttempt (AttemptNumber = $Next, Method = $Method, Card = if $Method = Fulfilment.PaymentMethod.CARD then $Card else empty, Amount = $TheOrder/Total,
    AttemptStatus = Fulfilment.PaymentAttemptStatus.PROCESSING, StartedAt = [%CurrentDateTime%], Fulfilment.PaymentAttempt_Order = $TheOrder) commit without events;
  call microflow Fulfilment.SUB_Order_Transition(TheOrder = $TheOrder, ToStatus = Fulfilment.OrderStatus.PAYMENT_PENDING, Actor = $Actor, ActorName = $ActorName, Reason = '');
  call microflow Fulfilment.SUB_Order_Log(TheOrder = $TheOrder, Level = Fulfilment.LogLevel.INFO, Tag = 'PAYMENT', Message = 'Retrying payment (attempt ' + toString($Next) + ' of 3)…', Visible = true);
  call microflow Fulfilment.SUB_Order_RefreshPaymentLabel(TheOrder = $TheOrder);
  return true;
end;

/**
 * Refunds a paid order in full (BR-ORD-10, BR-PRICE-14): the succeeded
 * attempt becomes REFUNDED with refundedAt and a rfd_sim_ id.
 *
 * @param $TheOrder The order
 */
create or modify microflow Fulfilment.SUB_Order_Refund ($TheOrder: Fulfilment.Order)
folder 'Orders'
begin
  if $TheOrder/Payment != Fulfilment.PaymentStatus.PAID then
    return;
  end if;
  retrieve $Paid from Fulfilment.PaymentAttempt where [Fulfilment.PaymentAttempt_Order = $TheOrder and AttemptStatus = 'SUCCEEDED'] first;
  if $Paid != empty then
    $Hex = call microflow Core.SUB_RandomHex(Length = 12);
    change $Paid (AttemptStatus = Fulfilment.PaymentAttemptStatus.REFUNDED, RefundedAt = [%CurrentDateTime%], RefundId = 'rfd_sim_' + $Hex) commit without events;
  end if;
  change $TheOrder (Payment = Fulfilment.PaymentStatus.REFUNDED) commit without events;
end;

/**
 * Cancels an order (T-04/T-06/T-07/T-09): records who and why, refunds a
 * paid order, voids a processing attempt and writes the log line.
 *
 * @param $TheOrder The order
 * @param $Actor GUEST or SYSTEM
 * @param $ActorName guest, sys/timer, …
 * @param $Reason Reason stored with the order and the status change
 * @param $LogMessage Customer-visible [ROLLBACK] line
 */
create or modify microflow Fulfilment.SUB_Order_Cancel ($TheOrder: Fulfilment.Order, $Actor: Enumeration(Fulfilment.ActorType), $ActorName: String, $Reason: String, $LogMessage: String)
folder 'Orders'
begin
  retrieve $Processing from Fulfilment.PaymentAttempt where [Fulfilment.PaymentAttempt_Order = $TheOrder and AttemptStatus = 'PROCESSING'];
  loop $Proc in $Processing
  begin
    change $Proc (AttemptStatus = Fulfilment.PaymentAttemptStatus.FAILED, FailureCode = Fulfilment.PaymentFailureCode.VOIDED, FinishedAt = [%CurrentDateTime%]);
  end loop;
  commit $Processing without events;
  change $TheOrder (CancelledAt = [%CurrentDateTime%], CancelledBy = $Actor, CancelReason = $Reason);
  call microflow Fulfilment.SUB_Order_Transition(TheOrder = $TheOrder, ToStatus = Fulfilment.OrderStatus.CANCELLED, Actor = $Actor, ActorName = $ActorName, Reason = $Reason);
  call microflow Fulfilment.SUB_Order_Refund(TheOrder = $TheOrder);
  call microflow Fulfilment.SUB_Order_Log(TheOrder = $TheOrder, Level = Fulfilment.LogLevel.ERROR, Tag = 'ROLLBACK', Message = $LogMessage, Visible = true);
end;
