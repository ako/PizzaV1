mdl 1;
-- Placeholders that break the layout ↔ snippet ↔ microflow ↔ page cycle.
-- `if not exists` makes them no-ops once the real page exists (see resolve-forward-references).

create page if not exists Shop.Home (Title: 'Home', Layout: Atlas_Core.Atlas_Default) { dynamictext ph (Content: '…') };
create page if not exists Shop.Menu (Title: 'Menu', Layout: Atlas_Core.Atlas_Default) { dynamictext ph (Content: '…') };
create page if not exists Shop.Configurator (Title: 'Configurator', Layout: Atlas_Core.Atlas_Default, Params: ($Line: Shop.CartLine)) { dynamictext ph (Content: '…') };
create page if not exists Shop.ItemInfo (Title: 'ItemInfo', Layout: Atlas_Core.PopupLayout, Params: ($Product: Catalog.Product)) { dynamictext ph (Content: '…') };
create page if not exists Shop.Cart_Drawer (Title: 'Cart_Drawer', Layout: Atlas_Core.PopupLayout, Params: ($Cart: Shop.Cart)) { dynamictext ph (Content: '…') };
create page if not exists Shop.Checkout (Title: 'Checkout', Layout: Atlas_Core.Atlas_Default) { dynamictext ph (Content: '…') };
create page if not exists Shop.PaymentSheet (Title: 'PaymentSheet', Layout: Atlas_Core.PopupLayout, Params: ($TheOrder: Fulfilment.Order)) { dynamictext ph (Content: '…') };
create page if not exists Shop.Confirmation (Title: 'Confirmation', Layout: Atlas_Core.PopupLayout, Params: ($TheOrder: Fulfilment.Order)) { dynamictext ph (Content: '…') };
create page if not exists Shop.Tracking (Title: 'Tracking', Layout: Atlas_Core.Atlas_Default, Params: ($TheOrder: Fulfilment.Order)) { dynamictext ph (Content: '…') };
create page if not exists Shop.TrackLookup (Title: 'TrackLookup', Layout: Atlas_Core.Atlas_Default) { dynamictext ph (Content: '…') };
create page if not exists Shop.Receipt (Title: 'Receipt', Layout: Atlas_Core.Atlas_Default, Params: ($TheOrder: Fulfilment.Order)) { dynamictext ph (Content: '…') };
create page if not exists Shop.NotFound (Title: 'NotFound', Layout: Atlas_Core.Atlas_Default) { dynamictext ph (Content: '…') };
create page if not exists Shop.UnexpectedError (Title: 'UnexpectedError', Layout: Atlas_Core.Atlas_Default) { dynamictext ph (Content: '…') };
create page if not exists Shop.AllergenNotice (Title: 'AllergenNotice', Layout: Atlas_Core.PopupLayout) { dynamictext ph (Content: '…') };
create snippet if not exists Shop.SNIP_HomeActiveOrder { container ph { } };
create page if not exists Shop.TrackInvalid (Title: 'TrackInvalid', Layout: Atlas_Core.Atlas_Default) { dynamictext ph (Content: '…') };
