  $p_pz_08 = create Shop.Product (Code = 'PZ-08', Name = 'Quad-Core Formaggi', ModuleKey = 'quad-core-formaggi', RealWorldName = 'Quattro formaggi', ShortDescription = 'Four cheeses, no sauce: mozzarella, gorgonzola, fontina and aged hard cheese.', Description = 'Four cores running in parallel. A bianca base of fior di latte, creamy gorgonzola dolce, nutty fontina and a vegetarian parmesan-style hard cheese, baked until bubbling and finished with extra-virgin olive oil. Rich, savory and perfectly multithreaded.', VersionTag = 'v4.0', Kind = Shop.ProductKind.PIZZA, ProductStatus = Shop.ProductStatus.PUBLISHED, IsSoldOut = false, IsFeatured = false, HasBadgeClassic = false, HasBadgeBestSeller = false, HasBadgeNew = false, HasBadgeChefPick = false, Spice = Shop.SpiceLevel.NONE, IsDeclaredVegetarian = false, IsDeclaredVegan = false, IsCrustSelectable = true, MaxExtras = 5, ImageFile = 'pz-08-quad-core-formaggi.jpg', ImageAlt = 'Quad-Core Formaggi: golden four-cheese pizza with melted pools of gorgonzola.', CaffeineMg = 0, SortOrder = 8, Shop.Product_Category = $cat_pizzas);
