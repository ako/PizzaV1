  $p_pz_01 = create Shop.Product (Code = 'PZ-01', Name = 'The Root Pizza', ModuleKey = 'root-pizza', RealWorldName = 'Margherita', ShortDescription = 'San Marzano tomatoes, fior di latte and fresh basil on our 48-hour dough.', Description = 'The essential foundation. Hand-crushed San Marzano DOP tomatoes, creamy fior di latte mozzarella and torn basil on a 48-hour fermented Neapolitan crust, finished with a ribbon of cold-pressed extra-virgin olive oil. Clean, minimal and perfectly balanced: the architecture of pure flavor.', VersionTag = 'v1.0-LTS', Kind = Shop.ProductKind.PIZZA, ProductStatus = Shop.ProductStatus.PUBLISHED, IsSoldOut = false, IsFeatured = true, HasBadgeClassic = true, HasBadgeBestSeller = false, HasBadgeNew = false, HasBadgeChefPick = false, Spice = Shop.SpiceLevel.NONE, IsDeclaredVegetarian = false, IsDeclaredVegan = false, IsCrustSelectable = true, MaxExtras = 5, ImageFile = 'pz-01-root-pizza.jpg', ImageAlt = 'The Root Pizza: Margherita with San Marzano tomato, melted fior di latte and fresh basil leaves.', CaffeineMg = 0, SortOrder = 1, Shop.Product_Category = $cat_pizzas);
