mdl 1;
-- Order core: log lines, audited status transitions (BR-ORD-01/02), labels.

/**
 * Stores the label of the order's payment method: the card label
 * (Visa •••• 4242) or the wallet name, from the latest attempt.
 *
 * @param $TheOrder The order
 */
create or modify microflow Fulfilment.SUB_Order_RefreshPaymentLabel ($TheOrder: Fulfilment.Order)
folder 'Orders'
begin
  retrieve $Attempt from Fulfilment.PaymentAttempt where [Fulfilment.PaymentAttempt_Order = $TheOrder] sort by AttemptNumber desc first;
  declare $Label String = '';
  if $Attempt != empty then
    if $Attempt/Method = Fulfilment.PaymentMethod.CARD and $Attempt/Card != empty then
      set $Label = getCaption($Attempt/Card);
    else
      set $Label = getCaption($Attempt/Method);
    end if;
    change $Attempt (MethodLabel = $Label) commit without events;
  end if;
  change $TheOrder (PaymentLabel = $Label) commit without events;
end;

/**
 * Appends one terminal-style log line to an order (BR-ORD-02, SIM-07).
 *
 * @param $TheOrder The order
 * @param $Level Log level
 * @param $Tag Tag shown in brackets, e.g. OVEN
 * @param $Message Message text with real values filled in
 * @param $Visible False for staff-only and DEBUG lines (never shown to guests)
 */
create or modify microflow Fulfilment.SUB_Order_Log ($TheOrder: Fulfilment.Order, $Level: Enumeration(Fulfilment.LogLevel), $Tag: String, $Message: String, $Visible: Boolean)
folder 'Orders'
begin
  retrieve $Last from Fulfilment.OrderLogEntry where [Fulfilment.OrderLogEntry_Order = $TheOrder] sort by Seq desc first;
  declare $Seq Integer = 1;
  if $Last != empty then
    set $Seq = $Last/Seq + 1;
  end if;
  $Entry = create Fulfilment.OrderLogEntry (LoggedAt = [%CurrentDateTime%], TimeText = formatDateTime([%CurrentDateTime%], 'HH:mm:ss'), Level = $Level, Tag = $Tag, Message = $Message,
    IsCustomerVisible = $Visible and $Level != Fulfilment.LogLevel.DEBUG, Seq = $Seq, Fulfilment.OrderLogEntry_Order = $TheOrder) commit without events;
end;

/**
 * Moves an order to a new status: sets the status and time, records one
 * OrderStatusChange (BR-ORD-02) and writes exactly one INFO line on the
 * Simulation log node (LITE-CFG-04), without contact data or tokens
 * (LITE-CFG-08). Guards are the caller's responsibility.
 *
 * @param $TheOrder The order
 * @param $ToStatus The new status
 * @param $Actor Actor type
 * @param $ActorName Actor name, e.g. sim/kitchen-auto or guest
 * @param $Reason Reason (cancellations), may be empty
 */
create or modify microflow Fulfilment.SUB_Order_Transition ($TheOrder: Fulfilment.Order, $ToStatus: Enumeration(Fulfilment.OrderStatus), $Actor: Enumeration(Fulfilment.ActorType), $ActorName: String, $Reason: String)
folder 'Orders'
begin
  declare $From Enumeration(Fulfilment.OrderStatus) = $TheOrder/OrderStatus;
  declare $Now DateTime = [%CurrentDateTime%];
  retrieve $Last from Fulfilment.OrderStatusChange where [Fulfilment.OrderStatusChange_Order = $TheOrder] sort by Seq desc first;
  declare $Seq Integer = 1;
  if $Last != empty then
    set $Seq = $Last/Seq + 1;
  end if;
  declare $Open Boolean = $ToStatus != Fulfilment.OrderStatus.DELIVERED and $ToStatus != Fulfilment.OrderStatus.PICKED_UP and $ToStatus != Fulfilment.OrderStatus.CANCELLED;
  change $TheOrder (OrderStatus = $ToStatus, StatusChangedAt = $Now, IsOpen = $Open, TimerProgress = 0, TimerAnchorAt = $Now) commit without events;
  $Change = create Fulfilment.OrderStatusChange (FromStatus = $From, ToStatus = $ToStatus, ChangedAt = $Now, Actor = $Actor, ActorName = $ActorName, Reason = $Reason, Seq = $Seq, Fulfilment.OrderStatusChange_Order = $TheOrder) commit without events;
  declare $FromText String = 'NEW';
  if $From != empty then
    set $FromText = getKey($From);
  end if;
  log info node 'Simulation' 'ORDER MX-' + toString($TheOrder/OrderNumber) + ' ' + $FromText + ' -> ' + getKey($ToStatus) + ' by ' + $ActorName;
end;
