mdl 1;
-- Order core: log lines, audited status transitions (BR-ORD-01/02), labels.

/**
 * Stores the label of the order's payment method: the card label
 * (Visa •••• 4242) or the wallet name, from the latest attempt.
 *
 * @param $TheOrder The order
 */
create or modify microflow Shop.SUB_Order_RefreshPaymentLabel ($TheOrder: Shop.Order)
folder 'Orders'
begin
  retrieve $Attempt from Shop.PaymentAttempt where [Shop.PaymentAttempt_Order = $TheOrder] sort by AttemptNumber desc first;
  declare $Label String = '';
  if $Attempt != empty then
    if $Attempt/Method = Shop.PaymentMethod.CARD and $Attempt/Card != empty then
      set $Label = getCaption($Attempt/Card);
    else
      set $Label = getCaption($Attempt/Method);
    end if;
    change $Attempt (MethodLabel = $Label);
    commit $Attempt without events;
  end if;
  change $TheOrder (PaymentLabel = $Label);
  commit $TheOrder without events;
end;

/**
 * Appends one terminal-style log line to an order (BR-ORD-02, SIM-07).
 *
 * @param $TheOrder The order
 * @param $Level Log level
 * @param $Tag Tag shown in brackets, e.g. OVEN
 * @param $Message Message text with real values filled in
 * @param $Visible False for staff-only and DEBUG lines (never shown to guests)
 */
create or modify microflow Shop.SUB_Order_Log ($TheOrder: Shop.Order, $Level: Enumeration(Shop.LogLevel), $Tag: String, $Message: String, $Visible: Boolean)
folder 'Orders'
begin
  retrieve $Last from Shop.OrderLogEntry where [Shop.OrderLogEntry_Order = $TheOrder] sort by Seq desc first;
  declare $Seq Integer = 1;
  if $Last != empty then
    set $Seq = $Last/Seq + 1;
  end if;
  $Entry = create Shop.OrderLogEntry (LoggedAt = [%CurrentDateTime%], TimeText = formatDateTime([%CurrentDateTime%], 'HH:mm:ss'), Level = $Level, Tag = $Tag, Message = $Message,
    IsCustomerVisible = $Visible and $Level != Shop.LogLevel.DEBUG, Seq = $Seq, Shop.OrderLogEntry_Order = $TheOrder);
  commit $Entry without events;
end;

/**
 * Moves an order to a new status: sets the status and time, records one
 * OrderStatusChange (BR-ORD-02) and writes exactly one INFO line on the
 * Simulation log node (LITE-CFG-04), without contact data or tokens
 * (LITE-CFG-08). Guards are the caller's responsibility.
 *
 * @param $TheOrder The order
 * @param $ToStatus The new status
 * @param $Actor Actor type
 * @param $ActorName Actor name, e.g. sim/kitchen-auto or guest
 * @param $Reason Reason (cancellations), may be empty
 */
create or modify microflow Shop.SUB_Order_Transition ($TheOrder: Shop.Order, $ToStatus: Enumeration(Shop.OrderStatus), $Actor: Enumeration(Shop.ActorType), $ActorName: String, $Reason: String)
folder 'Orders'
begin
  declare $From Enumeration(Shop.OrderStatus) = $TheOrder/OrderStatus;
  declare $Now DateTime = [%CurrentDateTime%];
  retrieve $Last from Shop.OrderStatusChange where [Shop.OrderStatusChange_Order = $TheOrder] sort by Seq desc first;
  declare $Seq Integer = 1;
  if $Last != empty then
    set $Seq = $Last/Seq + 1;
  end if;
  declare $Open Boolean = $ToStatus != Shop.OrderStatus.DELIVERED and $ToStatus != Shop.OrderStatus.PICKED_UP and $ToStatus != Shop.OrderStatus.CANCELLED;
  change $TheOrder (OrderStatus = $ToStatus, StatusChangedAt = $Now, IsOpen = $Open, TimerProgress = 0, TimerAnchorAt = $Now);
  commit $TheOrder without events;
  $Change = create Shop.OrderStatusChange (FromStatus = $From, ToStatus = $ToStatus, ChangedAt = $Now, Actor = $Actor, ActorName = $ActorName, Reason = $Reason, Seq = $Seq, Shop.OrderStatusChange_Order = $TheOrder);
  commit $Change without events;
  declare $FromText String = 'NEW';
  if $From != empty then
    set $FromText = getKey($From);
  end if;
  log info node 'Simulation' 'ORDER MX-' + toString($TheOrder/OrderNumber) + ' ' + $FromText + ' -> ' + getKey($ToStatus) + ' by ' + $ActorName;
end;
