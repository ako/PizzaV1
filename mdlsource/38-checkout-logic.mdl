mdl 1;
-- SCR-06 checkout logic (EP-05: US-081..US-097, US-101).

/**
 * Returns the guest's checkout form, creating it with the defaults:
 * DELIVERY, San Francisco / CA, tip 15 %, Card with Visa •••• 4242.
 *
 * @returns The checkout form
 */
create or modify microflow Shop.SUB_Checkout_Current ()
returns Shop.CheckoutForm as $Form
folder 'Checkout'
begin
  retrieve $Existing from Shop.CheckoutForm where [Shop.CheckoutForm_Owner = '[%CurrentUser%]'] first;
  if $Existing != empty then
    return $Existing;
  end if;
  $Form = create Shop.CheckoutForm (OrderType = Shop.OrderType.DELIVERY, City = 'San Francisco', StateCode = 'CA', Tip = Shop.TipOption.FIFTEEN,
    Method = Shop.PaymentMethod.CARD, Card = Shop.TestCard.VISA_4242, Shop.CheckoutForm_Owner = [%CurrentUser%]) commit without events;
  return $Form;
end;

/**
 * Recalculates the checkout summary on the server (US-083, US-086..US-089,
 * US-093, US-094): delivery-zone check of the ZIP code, amounts per
 * BR-PRICE with the order type and tip, the coupon re-checked for the order
 * type, the delivery minimum and the pickup ready time.
 *
 * @param $Form The checkout form
 */
create or modify microflow Shop.SUB_Checkout_Compute ($Form: Shop.CheckoutForm)
folder 'Checkout'
begin
  $Cart = call microflow Shop.SUB_Cart_Current();
  retrieve $Store from Shop.StoreSettings first;
  retrieve $Sim from Shop.SimulationSettings first;
  retrieve $Coupon from $Cart/Shop.Cart_Coupon;
  declare $Delivery Boolean = $Form/OrderType = Shop.OrderType.DELIVERY;
  -- zone check
  declare $Zip String = if $Form/Zip = empty then '' else trim($Form/Zip);
  declare $ZoneMsg String = '';
  declare $IsZoneOk Boolean = false;
  declare $Outside Boolean = false;
  declare $Trip Integer = 0;
  if isMatch($Zip, '[0-9]{5}') then
    retrieve $Zone from Shop.DeliveryZone where [Zip = $Zip and IsActive = true] first;
    if $Zone != empty then
      set $IsZoneOk = true;
      set $ZoneMsg = 'ZONE_OK // ZIP ' + $Zip + ' · ' + $Zone/Neighborhood + ' · ' + formatDecimal($Zone/DistanceMiles, '0.0') + ' mi';
      set $Trip = round($Sim/TravelBase + $Sim/TravelPerMile * $Zone/DistanceMiles);
      change $Form (Shop.CheckoutForm_Zone = $Zone);
    else
      set $Outside = true;
      set $ZoneMsg = $Zip + ' is outside the delivery zone. We deliver to 94102, 94103, 94105, 94107, 94110, 94114, 94117 and 94158.';
      change $Form (Shop.CheckoutForm_Zone = empty);
    end if;
  else
    change $Form (Shop.CheckoutForm_Zone = empty);
  end if;
  $Price = call microflow Shop.SUB_Price_Compute(Subtotal = $Cart/Subtotal, OrderType = $Form/OrderType, Coupon = $Coupon, Tip = $Form/Tip);
  declare $NetAmount Decimal = $Cart/Subtotal - $Price/Discount;
  $T0 = call microflow Shop.SUB_Money(Amount = 0);
  $T10 = call microflow Shop.SUB_Money(Amount = round($NetAmount * 10 div 100, 2));
  $T15 = call microflow Shop.SUB_Money(Amount = round($NetAmount * 15 div 100, 2));
  $T20 = call microflow Shop.SUB_Money(Amount = round($NetAmount * 20 div 100, 2));
  $SubText = call microflow Shop.SUB_Money(Amount = $Cart/Subtotal);
  $DiscText = call microflow Shop.SUB_Money(Amount = 0 - $Price/Discount);
  $FeeMoney = call microflow Shop.SUB_Money(Amount = $Price/DeliveryFee);
  $TaxText = call microflow Shop.SUB_Money(Amount = $Price/Tax);
  $TipText = call microflow Shop.SUB_Money(Amount = $Price/TipAmount);
  $TotalText = call microflow Shop.SUB_Money(Amount = $Price/Total);
  declare $FeeNote String = '';
  if $Delivery and $Price/FeeWaivedBy = Shop.FeeWaiver.THRESHOLD then
    set $FeeNote = 'free from $40.00';
  end if;
  if $Delivery and $Price/FeeWaivedBy = Shop.FeeWaiver.COUPON then
    set $FeeNote = 'FREE_DISPATCH';
  end if;
  declare $MinMsg String = '';
  if $Delivery and $Cart/Subtotal < $Store/MinDeliverySubtotal and $Cart/ItemCount > 0 then
    $Missing = call microflow Shop.SUB_Money(Amount = $Store/MinDeliverySubtotal - $Cart/Subtotal);
    set $MinMsg = 'Delivery needs a subtotal of at least $15.00 (' + $Missing + ' more). Choose pickup or add more.';
  end if;
  declare $CouponLine String = '';
  if $Coupon != empty then
    set $CouponLine = 'Coupon ' + $Coupon/Code + ': ' + $Price/CouponMessage;
  end if;
  -- ETA: ready = queueWait + bake + qa; delivery adds courier, handover and trip
  $ReadyEff = call microflow Shop.SUB_Eff(Base = $Sim/QueueWait + $Sim/Bake + $Sim/Qa);
  declare $ReadyAt DateTime = addSeconds([%CurrentDateTime%], $ReadyEff);
  declare $AvgTrip Integer = if $Trip > 0 then $Trip else 140;
  $DeliveryEff = call microflow Shop.SUB_Eff(Base = $Sim/QueueWait + $Sim/Bake + $Sim/Qa + $Sim/CourierToStore + $Sim/Handover + $AvgTrip);
  declare $Minutes Integer = max(1, round($DeliveryEff div 60));
  change $Form (ZoneMessage = $ZoneMsg, IsZoneOk = $IsZoneOk, IsZoneOutside = $Outside, Subtotal = $Cart/Subtotal, Discount = $Price/Discount,
    DeliveryFee = $Price/DeliveryFee, FeeNote = $FeeNote, Tax = $Price/Tax, TipAmount = $Price/TipAmount, TipPercent = $Price/TipPercent, Total = $Price/Total,
    Tip0Label = $T0, Tip10Label = $T10, Tip15Label = $T15, Tip20Label = $T20, MinimumMessage = $MinMsg,
    SubtotalText = $SubText, DiscountText = $DiscText, FeeText = if $Delivery then $FeeMoney else 'FREE', TaxText = $TaxText, TipText = $TipText, TotalText = $TotalText,
    CouponLine = $CouponLine, CouponCode = if $Coupon = empty then '' else $Coupon/Code, HasDiscount = $Price/Discount > 0,
    ReadyEstimate = formatDateTime($ReadyAt, 'HH:mm'), EtaText = '~' + toString($Minutes) + ' min after payment',
    IsCartBlocked = $Cart/CheckoutBlock != empty and $Cart/CheckoutBlock != '' and $Cart/ItemCount > 0, IsEmptyCart = $Cart/ItemCount = 0);
end;

/**
 * Recalculates the checkout form and saves it.
 *
 * @param $Form The checkout form
 */
create or modify microflow Shop.SUB_Checkout_Recalculate ($Form: Shop.CheckoutForm)
folder 'Checkout'
begin
  $CurrentCart = call microflow Shop.SUB_Cart_Current();
  call microflow Shop.SUB_Cart_Recalculate(Cart = $CurrentCart);
  call microflow Shop.SUB_Checkout_Compute(Form = $Form);
  commit $Form without events refresh;
end;

/**
 * Data source of the checkout page.
 *
 * @returns The guest's checkout form, recalculated
 */
create or modify microflow Shop.DS_Checkout ()
returns Shop.CheckoutForm as $Form
folder 'Checkout'
begin
  $Form = call microflow Shop.SUB_Checkout_Current();
  call microflow Shop.SUB_Checkout_Recalculate(Form = $Form);
  return $Form;
end;
grant execute on microflow Shop.DS_Checkout to Shop.Guest; -- auto

/**
 * Order type switch (US-081); entered address and tip are kept.
 *
 * @param $Form The checkout form
 * @param $Type DELIVERY or PICKUP
 */
create or modify microflow Shop.SUB_Checkout_Type ($Form: Shop.CheckoutForm, $Type: String)
folder 'Checkout'
begin
  change $Form (OrderType = if $Type = 'PICKUP' then Shop.OrderType.PICKUP else Shop.OrderType.DELIVERY);
  call microflow Shop.SUB_Checkout_Recalculate(Form = $Form);
end;

/**
 * Order type switch (US-081); entered address and tip are kept.
 * Page entry point; the logic is in SUB_Checkout_Type.
 *
 * @param $Form The checkout form
 * @param $Type DELIVERY or PICKUP
 */
create or modify microflow Shop.ACT_Checkout_Type ($Form: Shop.CheckoutForm, $Type: String)
folder 'Checkout'
begin
  call microflow Shop.SUB_Checkout_Type(Form = $Form, Type = $Type);
end;
grant execute on microflow Shop.ACT_Checkout_Type to Shop.Guest; -- auto

/**
 * Tip selection (US-086).
 *
 * @param $Form The checkout form
 * @param $Tip NONE, TEN, FIFTEEN or TWENTY
 */
create or modify microflow Shop.SUB_Checkout_Tip ($Form: Shop.CheckoutForm, $Tip: String)
folder 'Checkout'
begin
  change $Form (Tip = if $Tip = 'NONE' then Shop.TipOption.NONE else if $Tip = 'TEN' then Shop.TipOption.TEN else if $Tip = 'TWENTY' then Shop.TipOption.TWENTY else Shop.TipOption.FIFTEEN);
  call microflow Shop.SUB_Checkout_Recalculate(Form = $Form);
end;

/**
 * Tip selection (US-086).
 * Page entry point; the logic is in SUB_Checkout_Tip.
 *
 * @param $Form The checkout form
 * @param $Tip NONE, TEN, FIFTEEN or TWENTY
 */
create or modify microflow Shop.ACT_Checkout_Tip ($Form: Shop.CheckoutForm, $Tip: String)
folder 'Checkout'
begin
  call microflow Shop.SUB_Checkout_Tip(Form = $Form, Tip = $Tip);
end;
grant execute on microflow Shop.ACT_Checkout_Tip to Shop.Guest; -- auto

/**
 * Payment method and demo test card (US-101). Wallets need no card.
 *
 * @param $Form The checkout form
 * @param $Method CARD, APPLE_PAY or GOOGLE_PAY
 * @param $Card Test card key, or empty for wallets
 */
create or modify microflow Shop.SUB_Checkout_Pay ($Form: Shop.CheckoutForm, $Method: String, $Card: String)
folder 'Checkout'
begin
  change $Form (Method = if $Method = 'APPLE_PAY' then Shop.PaymentMethod.APPLE_PAY else if $Method = 'GOOGLE_PAY' then Shop.PaymentMethod.GOOGLE_PAY else Shop.PaymentMethod.CARD);
  if $Card != '' then
    change $Form (Card = if $Card = 'MASTERCARD_4444' then Shop.TestCard.MASTERCARD_4444 else if $Card = 'VISA_0002' then Shop.TestCard.VISA_0002 else if $Card = 'VISA_9995' then Shop.TestCard.VISA_9995 else if $Card = 'AMEX_0005' then Shop.TestCard.AMEX_0005 else Shop.TestCard.VISA_4242);
  end if;
  commit $Form without events refresh;
end;

/**
 * Payment method and demo test card (US-101). Wallets need no card.
 * Page entry point; the logic is in SUB_Checkout_Pay.
 *
 * @param $Form The checkout form
 * @param $Method CARD, APPLE_PAY or GOOGLE_PAY
 * @param $Card Test card key, or empty for wallets
 */
create or modify microflow Shop.ACT_Checkout_Pay ($Form: Shop.CheckoutForm, $Method: String, $Card: String)
folder 'Checkout'
begin
  call microflow Shop.SUB_Checkout_Pay(Form = $Form, Method = $Method, Card = $Card);
end;
grant execute on microflow Shop.ACT_Checkout_Pay to Shop.Guest; -- auto

/**
 * Field change: recalculates the summary in memory and clears a corrected field's error (US-284 AC4).
 *
 * @param $Form The checkout form
 */
create or modify microflow Shop.ACT_Checkout_Changed ($Form: Shop.CheckoutForm)
folder 'Checkout'
begin
  -- no commit: rapid typing fires overlapping change calls on the same version
  call microflow Shop.SUB_Checkout_Compute(Form = $Form);
end;
grant execute on microflow Shop.ACT_Checkout_Changed to Shop.Guest; -- auto

/**
 * Switch to pickup from the outside-zone error (US-083 AC5).
 *
 * @param $Form The checkout form
 */
create or modify microflow Shop.SUB_Checkout_Pickup ($Form: Shop.CheckoutForm)
folder 'Checkout'
begin
  change $Form (OrderType = Shop.OrderType.PICKUP);
  call microflow Shop.SUB_Checkout_Recalculate(Form = $Form);
end;

/**
 * Switch to pickup from the outside-zone error (US-083 AC5).
 * Page entry point; the logic is in SUB_Checkout_Pickup.
 *
 * @param $Form The checkout form
 */
create or modify microflow Shop.ACT_Checkout_Pickup ($Form: Shop.CheckoutForm)
folder 'Checkout'
begin
  call microflow Shop.SUB_Checkout_Pickup(Form = $Form);
end;
grant execute on microflow Shop.ACT_Checkout_Pickup to Shop.Guest; -- auto

/**
 * Normalises a US phone number to (415) 555-0199; returns '' when invalid
 * (BR-DATA-06: 10 digits; digits, spaces, (), - and +1 accepted).
 *
 * @param $Raw Typed phone number
 * @returns Formatted phone or ''
 */
create or modify microflow Shop.SUB_FormatPhone ($Raw: String)
returns String as $Phone
folder 'Checkout'
begin
  if $Raw = empty then
    return '';
  end if;
  if not(isMatch(trim($Raw), '[0-9 ()+\-]+')) then
    return '';
  end if;
  declare $Digits String = replaceAll($Raw, '[^0-9]', '');
  if length($Digits) = 11 and startsWith($Digits, '1') then
    set $Digits = substring($Digits, 1);
  end if;
  if length($Digits) != 10 then
    return '';
  end if;
  return '(' + substring($Digits, 0, 3) + ') ' + substring($Digits, 3, 3) + '-' + substring($Digits, 6, 4);
end;

/**
 * Execute Order --force (US-091, BR-ORD-03): validates every field on the
 * server (messages at the field and a summary), checks the cart, the zone
 * and the delivery minimum, then places the order (T-01), grants the guest
 * access, and opens the payment sheet. Nothing is created when invalid.
 *
 * @param $Form The checkout form
 */
create or modify microflow Shop.SUB_Checkout_Place ($Form: Shop.CheckoutForm)
folder 'Checkout'
begin
  call microflow Shop.SUB_Checkout_Recalculate(Form = $Form);
  $Cart = call microflow Shop.SUB_Cart_Current();
  if $Cart/ItemCount = 0 then
    show page Shop.Menu();
    call microflow Shop.SUB_Toast(Message = 'MANIFEST.LOCK is empty. Import a module first.', Level = Shop.ToastLevel.INFO, ShouldShowCartAction = false);
    return;
  end if;
  if $Cart/CheckoutBlock != empty and $Cart/CheckoutBlock != '' then
    call microflow Shop.SUB_Toast(Message = $Cart/CheckoutBlock, Level = Shop.ToastLevel.ERROR, ShouldShowCartAction = true);
    return;
  end if;
  declare $Delivery Boolean = $Form/OrderType = Shop.OrderType.DELIVERY;
  declare $Errors Integer = 0;
  declare $Summary String = '';
  declare $Name String = if $Form/ContactName = empty then '' else trim($Form/ContactName);
  declare $Email String = if $Form/ContactEmail = empty then '' else trim($Form/ContactEmail);
  $Phone = call microflow Shop.SUB_FormatPhone(Raw = $Form/ContactPhone);
  declare $Line1 String = if $Form/AddressLine1 = empty then '' else trim($Form/AddressLine1);
  declare $City String = if $Form/City = empty then '' else trim($Form/City);
  declare $State String = if $Form/StateCode = empty then '' else toUpperCase(trim($Form/StateCode));
  declare $Zip String = if $Form/Zip = empty then '' else trim($Form/Zip);
  if $Delivery then
    if $Line1 = '' then
      validation feedback $Form/AddressLine1 message 'ADDRESS_LINE_1 is required';
      set $Errors = $Errors + 1;
      set $Summary = $Summary + 'ADDRESS_LINE_1 · ';
    end if;
    if $City = '' then
      validation feedback $Form/City message 'CITY is required';
      set $Errors = $Errors + 1;
      set $Summary = $Summary + 'CITY · ';
    end if;
    if not(isMatch($State, '[A-Z]{2}')) then
      validation feedback $Form/StateCode message if $State = '' then 'STATE is required' else 'STATE must be 2 letters, e.g. CA.';
      set $Errors = $Errors + 1;
      set $Summary = $Summary + 'STATE · ';
    end if;
    if not(isMatch($Zip, '[0-9]{5}')) then
      validation feedback $Form/Zip message if $Zip = '' then 'ZIP_CODE is required' else 'ZIP_CODE must be 5 digits.';
      set $Errors = $Errors + 1;
      set $Summary = $Summary + 'ZIP_CODE · ';
    else
      if not($Form/IsZoneOk) then
        validation feedback $Form/Zip message $Zip + ' is outside the delivery zone.';
        set $Errors = $Errors + 1;
        set $Summary = $Summary + 'ZIP_CODE · ';
      end if;
    end if;
  end if;
  if $Name = '' then
    validation feedback $Form/ContactName message 'CONTACT_NAME is required';
    set $Errors = $Errors + 1;
    set $Summary = $Summary + 'CONTACT_NAME · ';
  end if;
  if $Email = '' then
    validation feedback $Form/ContactEmail message 'CONTACT_EMAIL is required';
    set $Errors = $Errors + 1;
    set $Summary = $Summary + 'CONTACT_EMAIL · ';
  else
    if not(isMatch($Email, '[^@\s]+@[^@\s]+\.[^@\s]+')) then
      validation feedback $Form/ContactEmail message 'CONTACT_EMAIL must be a valid email address.';
      set $Errors = $Errors + 1;
      set $Summary = $Summary + 'CONTACT_EMAIL · ';
    end if;
  end if;
  if $Phone = '' then
    validation feedback $Form/ContactPhone message if $Form/ContactPhone = empty or trim($Form/ContactPhone) = '' then 'CONTACT_PHONE is required' else 'CONTACT_PHONE must be a US phone number with 10 digits.';
    set $Errors = $Errors + 1;
    set $Summary = $Summary + 'CONTACT_PHONE · ';
  end if;
  if $Form/Method = Shop.PaymentMethod.CARD and $Form/Card = empty then
    set $Errors = $Errors + 1;
    set $Summary = $Summary + 'PAYMENT_PROTOCOL · ';
  end if;
  if $Delivery and $Form/MinimumMessage != empty and $Form/MinimumMessage != '' then
    set $Errors = $Errors + 1;
    set $Summary = $Summary + 'DELIVERY_MINIMUM · ';
  end if;
  if $Errors > 0 then
    change $Form (ErrorCount = $Errors, ErrorSummary = 'Lint failed: ' + toString($Errors) + (if $Errors = 1 then ' env variable needs' else ' env variables need') + ' attention. ' + substring($Summary, 0, length($Summary) - 3)) commit without events refresh;
    return;
  end if;
  change $Form (ErrorCount = 0, ErrorSummary = '', ContactPhone = $Phone, StateCode = $State) commit without events;
  retrieve $Lines from Shop.CartLine where [Shop.CartLine_Cart = $Cart and IsDraft = false] sort by CreatedAt asc;
  retrieve $Coupon from $Cart/Shop.Cart_Coupon;
  retrieve $Zone from $Form/Shop.CheckoutForm_Zone;
  $Order = create Shop.Order (Source = Shop.OrderSource.GUEST, OrderType = $Form/OrderType, ContactName = $Name, ContactEmail = $Email, ContactPhone = $Phone,
    AddressLine1 = if $Delivery then $Line1 else '', AddressLine2 = if $Delivery then (if $Form/AddressLine2 = empty then '' else trim($Form/AddressLine2)) else '',
    City = if $Delivery then $City else '', StateCode = if $Delivery then $State else '', Zip = if $Delivery then $Zip else '',
    DeliveryNotes = if $Delivery then (if $Form/DeliveryNotes = empty then '' else trim($Form/DeliveryNotes)) else '',
    Tip = if $Delivery then $Form/Tip else Shop.TipOption.NONE, Shop.Order_Zone = if $Delivery then $Zone else empty, Shop.Order_PlacedBy = [%CurrentUser%], OrderNumber = 0);
  call microflow Shop.SUB_Order_Place(TheOrder = $Order, Lines = $Lines, Coupon = $Coupon, Method = $Form/Method,
    Card = if $Form/Method = Shop.PaymentMethod.CARD then $Form/Card else empty, Actor = Shop.ActorType.GUEST, ActorName = 'guest');
  call microflow Shop.SUB_Order_Grant(TheOrder = $Order);
  show page Shop.PaymentSheet(TheOrder = $Order);
end;

/**
 * Execute Order --force (US-091, BR-ORD-03): validates every field on the
 * server (messages at the field and a summary), checks the cart, the zone
 * and the delivery minimum, then places the order (T-01), grants the guest
 * access, and opens the payment sheet. Nothing is created when invalid.
 * Page entry point; the logic is in SUB_Checkout_Place.
 *
 * @param $Form The checkout form
 */
create or modify microflow Shop.ACT_Checkout_Place ($Form: Shop.CheckoutForm)
folder 'Checkout'
begin
  call microflow Shop.SUB_Checkout_Place(Form = $Form);
end;
grant execute on microflow Shop.ACT_Checkout_Place to Shop.Guest; -- auto

/**
 * Grants the current guest access to an order (LITE-SES-03) and makes it the
 * session's active order for the sidebar and ./track.log.
 *
 * @param $TheOrder The order
 */
create or modify microflow Shop.SUB_Order_Grant ($TheOrder: Shop.Order)
folder 'Orders'
begin
  retrieve $Existing from Shop.OrderAccess where [Shop.OrderAccess_Order = $TheOrder and Shop.OrderAccess_User = '[%CurrentUser%]'] first;
  if $Existing != empty then
    change $Existing (GrantedAt = [%CurrentDateTime%]) commit without events;
  else
    $Access = create Shop.OrderAccess (GrantedAt = [%CurrentDateTime%], Shop.OrderAccess_Order = $TheOrder, Shop.OrderAccess_User = [%CurrentUser%]) commit without events;
  end if;
  $Cart = call microflow Shop.SUB_Cart_Current();
  change $Cart (Shop.Cart_ActiveOrder = $TheOrder) commit without events refresh;
end;
grant execute on microflow Shop.SUB_Checkout_Current to Shop.Guest;
